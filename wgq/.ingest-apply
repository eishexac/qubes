# wgq install plan, run step by step by `qubes-ingest apply wgq`.
# Verbs are interpreted by the ingest script; nothing here is shell.
# Build the template: clones debian-13-minimal and bootstraps the salt
# connector over qvm-run. Slow the first time.
salt wgq.wg-template
# The same state applied INSIDE the template: packages and files.
salt-target wgq-debian-13 wgq.wg-template
# Create wgq-mgmt, sys-vpn-work and sys-firewall-work.
salt wgq.wg-qubes
# OPTIONAL -- answer 's' to skip: the qrexec grant that lets 'wgq firewall'
# apply the endpoint allowlist through a dom0 'ask' prompt. Without it, the
# tool prints a qvm-firewall block to paste instead.
policy 30-wgq.policy
