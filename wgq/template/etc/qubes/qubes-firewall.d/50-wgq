#!/bin/sh
#
# /etc/qubes/qubes-firewall.d/50-wgq
#
# Installed from the wgq template.  Runs as root on every qubes-firewall
# start, in every qube built from that template.
#
# Why this directory and not /rw/config/qubes-firewall-user-script:
# qubesagent/firewall.py runs the .d directory unconditionally, but skips
# the user script entirely when the custom-persist service is enabled.  A
# leak control that silently does not run is worse than none.
#
# Why failure is not signalled by exit status: Qubes invokes us with
# subprocess.call() and discards the return value.  Nothing reads it,
# nothing logs it.  So failure is expressed in the dataplane instead - if
# we cannot prove the rules landed, this qube stops forwarding at all.
#
# Nothing here is meant to be edited by hand.  The active peer is whatever
# /rw/config/wg/wg0.conf points at, and that peer's .meta file carries the
# resolver.  Both are written by `wgq`.

set -u

WG_DIR=/rw/config/wg
LINK="$WG_DIR/wg0.conf"
TUN=wg0
RUN_DIR=/run/wgq
STATE="$RUN_DIR/state"

note() { logger -t wgq-firewall -p daemon.notice -- "$*"; }
warn() { logger -t wgq-firewall -p daemon.err    -- "$*"; }

# Role is decided by the qube's service flag, not by what happens to be on
# disk: the Salt formula marks VPN qubes with the wgq-vpn service, so
# sys-fw-<zone> and ordinary AppVMs on this shared template fall out here.
[ -f /var/run/qubes-service/wgq-vpn ] || exit 0

mkdir -p "$RUN_DIR" || warn "cannot create $RUN_DIR; state will go unrecorded"

panic() {
	warn "FAILED: $* -- disabling forwarding"
	printf 'broken: %s\n' "$*" > "$STATE"
	sysctl -qw net.ipv4.ip_forward=0 2>/dev/null
	sysctl -qw net.ipv6.conf.all.forwarding=0 2>/dev/null
	# The sysctl gates the forward path, but a flow already offloaded into
	# the qubes-accel flowtable re-enters at the ingress hook and never
	# consults it (DESIGN.md section 4). Its conntrack entry is what keeps
	# it alive, so those must die too or the shutoff is incomplete.
	conntrack -F >/dev/null 2>&1
	exit 1
}

# A marked VPN qube that has not been configured yet must NOT behave like
# an ordinary proxy: before the first keygen/apply/switch there is no
# tunnel, and forwarding would send clients to the uplink in the clear --
# the exact leak this project exists to prevent. First-contact finding
# from the first hardware run.
if [ ! -d "$WG_DIR" ] || [ ! -L "$LINK" ]; then
	panic "no active peer configured yet (run wgq keygen/apply/switch); refusing to forward in the clear"
fi

is_ipv4() {
	case "$1" in
		''|*[!0-9.]*) return 1 ;;
	esac
	# Split on dots via IFS rather than a subshell. The expansion happens
	# before set runs, so reading $1 here is safe.
	oldifs=$IFS
	IFS=.
	# shellcheck disable=SC2086 # deliberate word splitting on IFS
	set -- $1
	IFS=$oldifs
	[ $# -eq 4 ] || return 1
	for octet in "$@"; do
		[ -n "$octet" ] || return 1
		[ "$octet" -le 255 ] 2>/dev/null || return 1
	done
	return 0
}

# ---------------------------------------------------------------------------
# Refuse to install rules into chains that do not exist or that nothing
# jumps to.  Rules in an orphaned chain look like success and protect
# nothing, which is the exact silent failure this project exists to avoid.
# ---------------------------------------------------------------------------

nft list chain ip  qubes custom-forward >/dev/null 2>&1 \
	|| panic "no 'ip qubes custom-forward' chain"
nft list chain ip6 qubes custom-forward >/dev/null 2>&1 \
	|| panic "no 'ip6 qubes custom-forward' chain"

# ---------------------------------------------------------------------------
# Kill switch.  Installed before anything else, so that a broken resolver
# further down can never leave this undone.
#
# ONE nft transaction, deliberately.  An earlier version flushed the chain
# and added the rules in separate nft calls; between those calls the chain
# was EMPTY, and a client packet traversing in that instant was not
# dropped -- it reached the qubes-accel 'flow add' rule at priority
# filter+5 and got OFFLOADED into the flowtable, whose fast path re-enters
# at the ingress hook and never traverses this chain again.  UDP offloads
# on the SECOND packet of a 5-tuple (kernel nft_flow_offload.c: only TCP
# requires established state), so one resolver retry inside the window was
# enough to mint a permanent, kill-switch-proof DNS leak -- found on
# hardware by verify.sh check 3.  A transaction has no window; it also
# only resets the counters atomically with the rules they count.
#
# Qubes reserves the custom-* chains and states in qubes-ipv4.nft that it
# will never modify them, so flushing is safe - and necessary, because we
# are re-run on tunnel up/down and whenever qubes-firewall (re)starts.
#
# Never use 'accept' in custom-forward.  The qubes forward chain jumps here
# first, and an accept terminates the whole base chain - skipping its
# trailing 'oifgroup 2 counter drop', which is what keeps unsolicited
# inbound off the client qubes.  Drops and non-terminal statements only.
#
# group 1 is the Qubes-managed uplink (network/setup-ip), group 2 is a
# downstream vif (network/vif-route-qubes).  Matching on the group rather
# than on eth0/vif* means a second uplink or a renamed interface fails
# closed instead of slipping through.
#
# The MSS clamp is unqualified on purpose: it only ever sees what survived
# the drop above, i.e. tunnel-bound traffic.  It stays after the drop.
# ---------------------------------------------------------------------------

nft -f - <<EOF || panic "install kill switch (atomic transaction refused)"
flush chain ip  qubes custom-forward
flush chain ip6 qubes custom-forward
add rule ip qubes custom-forward oifgroup != 2 oifname != "$TUN" counter drop
add rule ip6 qubes custom-forward counter drop
add rule ip qubes custom-forward tcp flags syn / syn,rst tcp option maxseg size set rt mtu
EOF

# Read the rules back.  Trust the dataplane, not the return codes.
nft list chain ip qubes custom-forward | grep -q "oifname != \"$TUN\"" \
	|| panic "IPv4 kill switch did not land"
nft list chain ip6 qubes custom-forward | grep -q 'drop' \
	|| panic "IPv6 kill switch did not land"

# ---------------------------------------------------------------------------
# No fast path in a VPN qube.  vif-route-qubes installs, on EVERY vif
# online event, 'table inet qubes-nat-accel': a flowtable plus a rule that
# offloads established client->uplink flows (iifgroup 2 -> oifgroup 1)
# into it.  Offloaded packets re-enter at the ingress hook and bypass the
# forward hook entirely -- including the kill switch above.  In this qube
# client traffic may only ever leave through $TUN, so the one flow class
# that rule accelerates is the one class that must never exist: drop the
# whole table.  Ordinary proxies (sys-fw-<zone>) keep their accel; only
# qubes marked wgq-vpn run this script past the service check above.
#
# Deleting it here covers boot and every tunnel up/down.  The hook below
# covers everything else: vif-route-qubes RE-CREATES the table each time
# any client attaches, and /rw/config/network-hooks.d is the one place it
# runs qube-local code AFTER doing so -- so the hook deletes the table at
# the exact moments it reappears.  firewall.d cannot do that: the
# qubes-firewall daemon runs it only at daemon start, never on events.
# ---------------------------------------------------------------------------

nft destroy table inet qubes-nat-accel 2>/dev/null \
	|| nft delete table inet qubes-nat-accel 2>/dev/null \
	|| true

HOOK_DIR=/rw/config/network-hooks.d
HOOK="$HOOK_DIR/90-wgq-no-accel"
if [ ! -x "$HOOK" ]; then
	mkdir -p "$HOOK_DIR" || warn "cannot create $HOOK_DIR; accel table will revive on vif events"
	cat > "$HOOK" <<'HOOKEOF' || warn "cannot install $HOOK"
#!/bin/sh
# Installed by 50-wgq. A VPN qube must not fast-path client flows past its
# kill switch: vif-route-qubes re-creates the qubes-nat-accel flowtable on
# every vif online event and runs these hooks right after, so this deletes
# it again each time. Arguments are ignored on purpose.
nft destroy table inet qubes-nat-accel 2>/dev/null \
	|| nft delete table inet qubes-nat-accel 2>/dev/null \
	|| true
HOOKEOF
	chmod 0755 "$HOOK" 2>/dev/null || warn "cannot chmod $HOOK"
fi

nft list table inet qubes-nat-accel >/dev/null 2>&1 \
	&& panic "qubes-nat-accel still present after delete"

# ---------------------------------------------------------------------------
# Pin client DNS.
#
# Qubes' own dnat-dns chain sits at 'hook prerouting priority dstnat'
# (-100).  A second chain at the same priority would tie, and netfilter
# commits whichever DNAT it evaluates first.  When Qubes wins, the rewrite
# is a no-op (its idea of "our resolver" is the same 10.139.1.1 it hands
# downstream) and the query goes into the tunnel addressed to an address
# that exists nowhere - a black hole, on a coin flip.  -150 outranks it.
# ---------------------------------------------------------------------------

peer=''
target=$(readlink "$LINK" 2>/dev/null) || target=''
if [ -n "$target" ]; then
	base=${target##*/}
	base=${base%.conf}
	case "$base" in
		''|.|..|*[!A-Za-z0-9_=+.-]*)
			warn "refusing peer name '$base' from $LINK" ;;
		*)
			peer=$base ;;
	esac
fi

dns=''
if [ -n "$peer" ] && [ -f "$WG_DIR/peers/$peer.meta" ]; then
	dns=$(sed -n 's/^dns=\(.*\)$/\1/p' "$WG_DIR/peers/$peer.meta" \
		| head -n 1 | tr -d '[:space:]')
	is_ipv4 "$dns" || { warn "peer '$peer' has an unusable resolver: '$dns'"; dns=''; }
fi

# One transaction, same reason as the kill switch above: between a flush
# and a re-add, a client query would fall through to Qubes' own dnat-dns
# chain at -100 -- an identity mapping in this qube -- and head for the
# uplink shaped exactly like the flow the flowtable loved to offload.
if [ -n "$dns" ]; then
	rule_udp="add rule ip qubes wgq-dns iifgroup 2 udp dport 53 dnat to $dns"
	rule_tcp="add rule ip qubes wgq-dns iifgroup 2 tcp dport 53 dnat to $dns"
else
	# No resolver we can vouch for.  Drop client DNS rather than let it
	# fall through to Qubes' chain and black-hole in the tunnel.  Borrowed
	# from qubes-setup-dnat-to-ns, which does the same when the qube has
	# no IPv4 resolver at all.
	warn "no resolver for peer '${peer:-none}' -- dropping client DNS"
	rule_udp="add rule ip qubes wgq-dns iifgroup 2 udp dport 53 counter drop"
	rule_tcp="add rule ip qubes wgq-dns iifgroup 2 tcp dport 53 counter drop"
fi

nft -f - <<EOF || panic "install DNS pin (atomic transaction refused)"
add chain ip qubes wgq-dns { type nat hook prerouting priority -150; policy accept; }
flush chain ip qubes wgq-dns
$rule_udp
$rule_tcp
EOF

if [ -n "$dns" ]; then
	printf 'ok peer=%s dns=%s\n' "$peer" "$dns" > "$STATE"
else
	printf 'degraded: no resolver for peer=%s; client DNS dropped\n' \
		"${peer:-none}" > "$STATE"
fi

# Same standard as the kill switch: trust what reads back, not return codes.
# Both branches above put a dport 53 rule in the chain, so its absence means
# the DNS pin silently did not land.
nft list chain ip qubes wgq-dns | grep -q 'dport 53' \
	|| panic "DNS rules did not land"

# ---------------------------------------------------------------------------
# Flows already offloaded into the qubes-accel flowtable re-enter at the
# ingress hook and never traverse the forward hook again, so they would
# keep flowing past everything above.  Flowtable entries are bound to
# conntrack entries and die with them.
# ---------------------------------------------------------------------------

# A previous run may have panicked and switched forwarding off, and nothing
# else ever switches it back on while the qube runs (boot-time network setup
# is once-only). Everything above has now been installed and read back, so
# re-enable it; without this line, one transient failure would wedge the
# qube until reboot while the state file claimed 'ok'. Only qubes with
# /rw/config/wg reach this far, and IPv6 forwarding stays off: wgq is
# IPv4-only and the v6 chain above drops everything anyway.
sysctl -qw net.ipv4.ip_forward=1 || panic "re-enable IPv4 forwarding"

conntrack -F >/dev/null 2>&1 \
	|| warn "conntrack flush failed -- flows established before these rules may persist"

note "applied: tunnel=$TUN peer=${peer:-none} resolver=${dns:-none}"
