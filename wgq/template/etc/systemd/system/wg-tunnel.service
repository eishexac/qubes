[Unit]
# No Documentation= line: systemd-analyze verify tries to resolve man: URIs
# and minimal templates ship no man pages.
Description=WireGuard tunnel for this qube
After=network-online.target qubes-misc-post.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=90
ExecStart=/usr/sbin/wg-tunnel up
ExecStop=/usr/sbin/wg-tunnel down

# No [Install] section, deliberately: this unit is MANUAL. Boot-time
# starting belongs to wg-autoconnect.service alone, so that the
# per-qube wgq-no-autoconnect flag can gate the boot without gating
# `wgq connect` (a Condition here would gate both).
