[Unit]
# The boot-time half of the connection lifecycle. wg-tunnel.service is
# deliberately manual (no [Install]): THIS unit, and only this unit,
# starts it at boot -- unless the qube carries the wgq-no-autoconnect
# service flag, set from dom0 with `wgq set autoconnect off`.
#
# Why a separate unit instead of a condition on wg-tunnel itself: a
# systemd Condition gates manual starts too, so a condition there would
# make `wgq connect` a no-op on an autoconnect-off qube -- the exact
# opposite of what the flag means. Split, the flag only touches boot.
#
# Autoconnect off still boots SEALED, not open: the kill switch and the
# refuse-to-forward behavior come from qubes-firewall.d/50-wgq, which
# runs regardless. An unconnected zone is a dark zone.
Description=Start the WireGuard tunnel at boot (default on)
After=network-online.target qubes-misc-post.service
Wants=network-online.target
ConditionPathExists=!/var/run/qubes-service/wgq-no-autoconnect

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl start wg-tunnel.service

[Install]
# Enabled in the TEMPLATE (see wg-tunnel.service for why).
WantedBy=multi-user.target
