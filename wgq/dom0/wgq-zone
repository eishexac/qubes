#!/bin/sh
#
# wgq-zone - zone lifecycle, from dom0, one deliberate act per command.
#
#     wgq-zone add <zone> [--upstream <netvm>] [--attach <qube>[,<qube>...]] ...
#     wgq-zone attach <zone> <qube>
#     wgq-zone detach <qube> [netvm]
#     wgq-zone list
#     wgq-zone remove <zone>
#
# The tool supports every topology -- one zone for everything, one per
# identity, a dedicated infra zone -- and decides none of them: the only
# qubes whose netvm ever changes are the ones typed on the command line.
# There is no discovery, no "all", no sweep; a tool that enumerates
# "networked qubes" for you will eventually rewire plumbing it does not
# understand (it once grabbed Whonix's own qubes). The single exception
# is one question, not a search: when a qube shares the zone's name,
# `add` asks about that qube and no other. Moving a qube that already
# belongs to another zone always requires a confirmation, because
# crossing zones is never a side effect.
#
# This runs in dom0 because creating qubes and rewiring netvms is dom0
# authority on purpose: granting those powers to a qube is exactly what
# this project refuses to do.

set -eu

# The dom0 dispatcher execs this as `wgq zone`; naming ourselves what
# the operator actually typed keeps every printed hint copy-pasteable.
PROG=${WGQ_PROG:-${0##*/}}

usage() {
	printf 'usage: %s add <zone> [-v] [--color <c>] [--upstream <netvm>] [--attach <qube>,...]\n' "$PROG" >&2
	printf '       %s attach <zone> <qube>\n' "$PROG" >&2
	printf '       %s detach <qube> [netvm]\n' "$PROG" >&2
	printf '       %s list\n' "$PROG" >&2
	printf '       %s rename <old> <new>       (migrate a zone -- including the reserved one)\n' "$PROG" >&2
	printf '       %s remove <zone>\n' "$PROG" >&2
	exit 2
}

# note/ok/warn/die come from msg.sh, which sits beside this script.
case "$0" in */*) wgq_here=${0%/*} ;; *) wgq_here=. ;; esac
# shellcheck source=dom0/msg.sh
. "$wgq_here/msg.sh"

check_zone() {
	# Mirrors the wgq CLI's zone rule; 21 chars keeps sys-wgq-/sys-fw-
	# names inside Qubes' 31-character limit.
	case "$1" in
		'' | *[!a-z0-9-]* | -*) die "unusable zone name '$1' (lowercase, digits, dashes)" ;;
		autoconnect | dns | default)
			# The words that let `set` tell a key from a zone; a zone
			# wearing one would make the grammar ambiguous forever.
			die "'$1' is a settings word and cannot name a zone"
			;;
	esac
	[ ${#1} -le 21 ] || die "zone name '$1' is longer than 21 characters"
}

check_qube_name() {
	case "$1" in
		'' | *[!A-Za-z0-9_.-]*) die "unusable qube name '$1'" ;;
	esac
}

zone_exists() { qvm-check --quiet "sys-fw-$1" 2>/dev/null; }

# A qube is wgq's if it carries the created-by-wgq tag (stamped by the
# salt states since the adoption guard) or wears a wgq label -- only
# dom0 can dress a qube, so the label is proof; older installs predate
# the tag and are recognized by their labels. Everything that lists,
# rewires or destroys by the sys-fw-* NAME grammar checks this first: a
# stranger's qube that happens to share the naming is not a zone.
is_ours() {
	qvm-tags "$1" list 2>/dev/null | grep -qx created-by-wgq && return 0
	case "$(qvm-prefs "$1" label 2>/dev/null)" in
		wgq | wgq-fw | wgq-mgmt | wgq-tpl) return 0 ;;
	esac
	return 1
}

# The reserved zone 'wgq' -- the single-VPN-for-everything default -- has
# the bare VPN qube name; every other zone follows sys-wgq-<zone>. The
# firewall name never varies: sys-fw-<zone> stays the parseable grammar.
vpn_name() {
	if [ "$1" = wgq ]; then printf 'sys-wgq\n'; else printf 'sys-wgq-%s\n' "$1"; fi
}

current_netvm() { qvm-prefs "$1" netvm 2>/dev/null || printf ''; }

# Attach one qube to a zone. Crossing out of another zone is a decision,
# so it always asks; same-zone re-attach is a quiet no-op.
attach_qube() {
	a_zone=$1 a_qube=$2
	check_qube_name "$a_qube"
	qvm-check --quiet "$a_qube" 2>/dev/null || die "no such qube '$a_qube'"
	# Routing a client through a stranger's qube is the one mistake this
	# tool must never make, so the zone's firewall must be wgq's own.
	is_ours "sys-fw-$a_zone" \
		|| die "sys-fw-$a_zone was not created by wgq; refusing to route $a_qube through it (if it is an old wgq install: qvm-tags sys-fw-$a_zone add created-by-wgq)"
	a_now=$(current_netvm "$a_qube")
	if [ "$a_now" = "sys-fw-$a_zone" ]; then
		note "$a_qube is already attached to zone $a_zone"
		return 0
	fi
	case "$a_now" in
		sys-fw-*)
			a_from=${a_now#sys-fw-}
			printf '%s: %s currently belongs to zone %s. Move it to %s? [y/N] ' \
				"$PROG" "$a_qube" "$a_from" "$a_zone"
			a_ans=""
			read -r a_ans || true
			case "$a_ans" in
				y | yes) ;;
				*)
					note "left $a_qube in zone $a_from"
					return 0
					;;
			esac
			;;
	esac
	# The same guard `add` ends with: a halted netvm refuses clients, and
	# the zone qubes never autostart, so a zone shut down since creation
	# must come back up before the rewire.
	if ! qvm-check --running --quiet "sys-fw-$a_zone" 2>/dev/null; then
		note "starting sys-fw-$a_zone first..."
		qvm-start --skip-if-running "sys-fw-$a_zone" \
			|| die "sys-fw-$a_zone did not start; $a_qube was not moved"
	fi
	qvm-prefs "$a_qube" netvm "sys-fw-$a_zone"
	ok "$a_qube now reaches the network only through zone $a_zone"
}

# The one question `add` asks on its own: a qube sharing the zone's name
# is an obvious candidate, and the question names that single qube, never
# a list nothing was typed for. Skipped when it is already attached.
offer_name_match() {
	o_zone=$1
	qvm-check --quiet "$o_zone" 2>/dev/null || return 0
	[ "$(current_netvm "$o_zone")" = "sys-fw-$o_zone" ] && return 0
	printf '%s: a qube named %s exists. Attach it to this zone? [y/N] ' \
		"$PROG" "$o_zone"
	o_ans=""
	read -r o_ans || true
	case "$o_ans" in
		y | yes) attach_qube "$o_zone" "$o_zone" ;;
	esac
}

cmd_add() {
	# Every zone is named. The Enter-for-the-default prompt is gone: a
	# default was the one zone the operator never chose.
	[ $# -ge 1 ] || die "name the zone: $PROG add <name> [--upstream <netvm>] [--attach <qube>,...]"
	z=$1
	shift
	check_zone "$z"
	case "$z" in
		blue | orange | purple | cyan | magenta | green | yellow | teal | pink | red | gray | brown)
			die "'$z' is a palette colour and cannot name a zone"
			;;
	esac
	if [ "$z" = wgq ]; then
		# The reserved zone can no longer be BORN; an existing one (an
		# install from before 0.3.0) may still converge while its owner
		# migrates.
		qvm-check --quiet sys-fw-wgq 2>/dev/null \
			|| die "the reserved zone cannot be created anymore; pick a real name"
		warn "the reserved zone is deprecated; migrate with: $PROG rename wgq <name>"
	fi
	upstream=""
	attach_list=""
	colour=""
	verbose=0
	while [ $# -gt 0 ]; do
		case "$1" in
			-v)
				verbose=1
				shift
				;;
			--color | --colour)
				[ $# -ge 2 ] || usage
				colour=$2
				shift 2
				;;
			--upstream)
				[ $# -ge 2 ] || usage
				check_qube_name "$2"
				upstream=$2
				shift 2
				;;
			--attach)
				# One qube, or a typed list: --attach work,media. Still
				# only ever names the operator wrote out.
				if [ $# -lt 2 ] || [ -z "$2" ]; then usage; fi
				attach_list="$attach_list $(printf '%s' "$2" | tr ',' ' ')"
				shift 2
				;;
			*) usage ;;
		esac
	done

	# The zone's console colour: picked, or the first free one. Stored
	# as a feature on the VPN qube once it exists (below); uniqueness is
	# read from the features of the zones that already exist, so removal
	# frees a colour and rename carries it (clone copies features).
	used_colours=$(for uc_fw in $(qvm-ls --raw-data --fields name 2>/dev/null | grep '^sys-fw-' || true); do
		is_ours "$uc_fw" || continue
		uc_vpn="sys-wgq-${uc_fw#sys-fw-}"
		[ "${uc_fw#sys-fw-}" = wgq ] && uc_vpn=sys-wgq
		qvm-features "$uc_vpn" wgq.color 2>/dev/null || :
	done)
	if [ -n "$colour" ]; then
		zone_colour_code "$colour" >/dev/null 2>&1 \
			|| die "unknown colour '$colour'; the palette: $ZONE_PALETTE"
		if printf '%s\n' "$used_colours" | grep -qx "$colour"; then
			die "colour '$colour' is already worn by another zone; free: $(for c in $ZONE_PALETTE; do printf '%s\n' "$used_colours" | grep -qx "$c" || printf '%s ' "$c"; done)"
		fi
	else
		for c in $ZONE_PALETTE; do
			printf '%s\n' "$used_colours" | grep -qx "$c" && continue
			colour=$c
			break
		done
		[ -n "$colour" ] || note "the palette is spent; zone '$z' stays unpainted"
	fi

	pillar="{\"wgq\": {\"zone\": \"$z\"}}"
	if [ -n "$upstream" ]; then
		qvm-check --quiet "$upstream" 2>/dev/null || die "no such upstream netvm '$upstream'"
		pillar="{\"wgq\": {\"zone\": \"$z\", \"upstream\": \"$upstream\"}}"
	fi
	# The salt report is a wall; the default is its verdict, one line
	# per outcome, with the wall on failure or on -v -- because a wall
	# nobody reads teaches people to stop reading reports at all.
	note "creating $(vpn_name "$z") + sys-fw-$z via salt (can take a minute)..."
	if [ "$verbose" -eq 1 ]; then
		qubesctl --show-output state.apply wgq.wg-zone pillar="$pillar"
	else
		a_log=$(mktemp)
		if qubesctl --show-output state.apply wgq.wg-zone pillar="$pillar" >"$a_log" 2>&1 \
			&& ! grep -qE '^Failed:[[:space:]]+[1-9]' "$a_log"; then
			grep -E '^(Succeeded|Failed):' "$a_log" | sed 's/^/    /' || :
			note "(the full salt report: re-run with -v)"
			rm -f "$a_log"
		else
			cat "$a_log"
			rm -f "$a_log"
			die "salt converge failed; the full report is above"
		fi
	fi
	if [ -n "$colour" ]; then
		qvm-features "$(vpn_name "$z")" wgq.color "$colour" \
			|| warn "could not store the colour; re-run: $PROG add $z --color $colour"
		note "zone $z wears $(paint_to 2 "$colour" "$colour")"
	fi

	# A newborn zone inherits the global settings from its first boot:
	# once BEFORE the start so the boot flag exists when systemd reads
	# it, once AFTER (below) so the resolver copy lands in the running
	# qube. Failures are surfaced, not eaten -- with a global
	# autoconnect off, a silently failed flag write would boot this
	# zone connected against stored intent.
	"$wgq_here/wgq-ctl" --zone "$z" materialize \
		|| warn "settings did not materialize; before relying on the zone run: sudo wgq -z $z connect"

	# Creation ends with the plumbing RUNNING: Qubes only assigns clients
	# to a netvm that is up, so a zone left halted would refuse its first
	# attach. This is the one-time completion of `add`, not a boot policy
	# -- autostart stays off on purpose.
	note "starting sys-fw-$z (boots $(vpn_name "$z") behind it)..."
	qvm-start --skip-if-running "sys-fw-$z" \
		|| die "sys-fw-$z did not start; 'attach' will retry when you use it"
	"$wgq_here/wgq-ctl" --zone "$z" materialize \
		|| warn "settings did not materialize; before relying on the zone run: sudo wgq -z $z connect"
	ok "zone $z is up ($(vpn_name "$z") + sys-fw-$z)"

	for q in $attach_list; do
		attach_qube "$z" "$q"
	done
	offer_name_match "$z"
	note "attach clients with: $PROG attach $z <qube>"
}

cmd_rename() {
	# Qubes has no in-place rename, so this is clone-retag-rewire-remove
	# -- with the zone dark for the duration, said up front. The private
	# volumes travel with the clones: keys, peers and the active symlink
	# arrive intact, so the registered provider key survives.
	[ $# -eq 2 ] || usage
	r_old=$1
	r_new=$2
	check_zone "$r_old"
	check_zone "$r_new"
	[ "$r_old" != "$r_new" ] || die "'$r_old' to '$r_new' is not a rename"
	[ "$r_new" != wgq ] || die "nothing may take the reserved name"
	r_old_vpn=$(vpn_name "$r_old")
	r_old_fw="sys-fw-$r_old"
	r_new_vpn="sys-wgq-$r_new"
	r_new_fw="sys-fw-$r_new"
	qvm-check --quiet "$r_old_fw" 2>/dev/null || die "zone '$r_old' does not exist"
	is_ours "$r_old_fw" || die "$r_old_fw was not created by wgq; not mine to rename"
	is_ours "$r_old_vpn" || die "$r_old_vpn was not created by wgq; not mine to rename"
	for r_q in "$r_new_vpn" "$r_new_fw"; do
		if qvm-check --quiet "$r_q" 2>/dev/null; then
			die "a qube named '$r_q' already exists"
		fi
	done
	r_uplink=$(qvm-prefs "$r_old_vpn" netvm 2>/dev/null | head -n1 || :)
	r_clients=$(qvm-ls --raw-data --fields name,netvm 2>/dev/null \
		| awk -F'|' -v fw="$r_old_fw" '$2 == fw {print $1}' | tr '\n' ' ')

	note "rename plan: $r_old_vpn -> $r_new_vpn, $r_old_fw -> $r_new_fw (clone, retag, rewire, remove)"
	[ -n "$r_clients" ] \
		&& note "clients ($r_clients) go DARK for the duration and follow to $r_new_fw"
	printf 'type the new name to confirm: '
	read -r r_ans || die "not confirmed"
	[ "$r_ans" = "$r_new" ] || die "not confirmed"

	qvm-shutdown --wait "$r_old_fw" || die "could not shut down $r_old_fw"
	qvm-shutdown --wait "$r_old_vpn" || die "could not shut down $r_old_vpn"
	qvm-clone "$r_old_vpn" "$r_new_vpn" || die "clone of $r_old_vpn failed; nothing was removed"
	qvm-clone "$r_old_fw" "$r_new_fw" || die "clone of $r_old_fw failed; nothing was removed"
	# clone copies tags on current Qubes, but the birth stamp is too
	# load-bearing to inherit implicitly
	qvm-tags "$r_new_vpn" add created-by-wgq
	qvm-tags "$r_new_fw" add created-by-wgq
	qvm-prefs "$r_new_fw" netvm "$r_new_vpn"
	if [ -n "$r_uplink" ] && [ "$r_uplink" != '-' ]; then
		qvm-prefs "$r_new_vpn" netvm "$r_uplink"
	fi
	# the mgmt bundle follows, so provision/sync keep addressing the
	# zone by its (new) name; zone names are charset-checked, embedding
	# them is safe
	qvm-run --no-gui --pass-io -u user -- wgq-mgmt \
		"if [ -d ~/.local/share/wgq/zones/$r_old ]; then mv ~/.local/share/wgq/zones/$r_old ~/.local/share/wgq/zones/$r_new; fi" \
		|| warn "could not move the mgmt bundle; in wgq-mgmt run: mv ~/.local/share/wgq/zones/$r_old ~/.local/share/wgq/zones/$r_new"
	for r_c in $r_clients; do
		qvm-prefs "$r_c" netvm "$r_new_fw" \
			|| warn "could not repoint $r_c; run: qvm-prefs $r_c netvm $r_new_fw"
	done
	qvm-remove -f "$r_old_fw" || die "could not remove $r_old_fw; the new zone exists, remove the old pair by hand"
	qvm-remove -f "$r_old_vpn" || die "could not remove $r_old_vpn; the new zone exists, remove it by hand"
	# the add path adopts the tagged clones, converges labels, features
	# and prefs, starts the pair and materializes the settings
	cmd_add "$r_new"
	ok "zone '$r_old' is now '$r_new'; firewall allowlist rides along, verify when convenient: sudo wgq verify $r_new"
}

cmd_attach() {
	[ $# -eq 2 ] || usage
	check_zone "$1"
	zone_exists "$1" || die "zone '$1' does not exist; create it with: $PROG add $1"
	attach_qube "$1" "$2"
}

cmd_detach() {
	[ $# -ge 1 ] || usage
	check_qube_name "$1"
	qvm-check --quiet "$1" 2>/dev/null || die "no such qube '$1'"
	target=${2:-$(qubes-prefs default_netvm 2>/dev/null || printf 'sys-firewall')}
	check_qube_name "$target"
	qvm-check --quiet "$target" 2>/dev/null || die "no such netvm '$target' to hand $1 to"
	case "$(current_netvm "$1")" in
		sys-fw-*) ;;
		*) die "$1 is not attached to any wgq zone" ;;
	esac
	qvm-prefs "$1" netvm "$target"
	ok "$1 detached; its network now comes from $target"
}

cmd_list() {
	# --json: one JSON document on stdout, notes stay on stderr. Safe to
	# assemble with printf because every embedded name is already charset-
	# checked (zones [a-z0-9-], qube names [A-Za-z0-9_.-]): no quotes, no
	# backslashes, nothing JSON needs escaped.
	l_json=0
	[ "${1:-}" = "--json" ] && l_json=1
	found=0
	l_out=''
	for fw in $(qvm-ls --raw-data --fields name 2>/dev/null | grep '^sys-fw-' || true); do
		if ! is_ours "$fw"; then
			note "$fw exists but was not created by wgq; not listed as a zone"
			continue
		fi
		found=1
		lz=${fw#sys-fw-}
		clients=$(qvm-ls --raw-data --fields name,netvm 2>/dev/null \
			| awk -F'|' -v fw="$fw" '$2 == fw {print $1}' | tr '\n' ' ')
		l_colour=$(qvm-features "$(vpn_name "$lz")" wgq.color 2>/dev/null || :)
		if [ "$l_json" -eq 1 ]; then
			l_clients=''
			for c in $clients; do
				l_clients="${l_clients:+$l_clients, }\"$c\""
			done
			l_row=$(printf '{"zone": "%s", "vpn": "%s", "fw": "%s", "color": "%s", "clients": [%s]}' \
				"$lz" "$(vpn_name "$lz")" "$fw" "$l_colour" "$l_clients")
			l_out="${l_out:+$l_out, }$l_row"
		else
			printf '%s  vpn=%s  clients: %s\n' \
				"$(paint_to 1 "$l_colour" "$(printf '%-21s' "$lz")")" \
				"$(vpn_name "$lz")" "${clients:-none}"
		fi
	done
	[ "$l_json" -eq 1 ] && printf '[%s]\n' "$l_out"
	[ "$found" -eq 1 ] || note "no zones exist; create one with: $PROG add <zone>"
}

cmd_remove() {
	[ $# -eq 1 ] || usage
	check_zone "$1"
	zone_exists "$1" || die "zone '$1' does not exist"
	is_ours "sys-fw-$1" \
		|| die "sys-fw-$1 was not created by wgq; refusing to destroy it (if it is an old wgq install: qvm-tags sys-fw-$1 add created-by-wgq)"
	rclients=$(qvm-ls --raw-data --fields name,netvm 2>/dev/null \
		| awk -F'|' -v fw="sys-fw-$1" '$2 == fw {print $1}' | tr '\n' ' ')
	if [ -n "${rclients% }" ]; then
		die "qubes still attached to zone '$1': ${rclients% }. Detach them first: $PROG detach <qube>"
	fi
	rvpn=$(vpn_name "$1")
	printf '%s: this DESTROYS sys-fw-%s and %s, including the zone'\''s\n' "$PROG" "$1" "$rvpn"
	printf 'private key. Type the zone name to confirm: '
	r_ans=""
	read -r r_ans || true
	[ "$r_ans" = "$1" ] || die "confirmation did not match; nothing removed"
	note "shutting down and removing the zone qubes..."
	qvm-shutdown --wait "sys-fw-$1" "$rvpn" 2>/dev/null || true
	qvm-remove -f "sys-fw-$1"
	qvm-remove -f "$rvpn"
	ok "zone $1 removed"
	note "its registered key still holds a provider device slot;"
	note "revoke it (wgq revoke / provider website) if it was ever provisioned."
}

case "${1:-}" in
	add)
		shift
		cmd_add "$@"
		;;
	attach)
		shift
		cmd_attach "$@"
		;;
	detach)
		shift
		cmd_detach "$@"
		;;
	list)
		shift
		cmd_list "$@"
		;;
	rename)
		shift
		cmd_rename "$@"
		;;
	remove)
		shift
		cmd_remove "$@"
		;;
	*) usage ;;
esac
