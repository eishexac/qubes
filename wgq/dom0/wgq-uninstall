#!/bin/sh
#
# wgq-uninstall - take wgq off this machine, one confirmed step at a time.
#
#     sudo /srv/salt/wgq/dom0/wgq-uninstall
#
# Removal order: zones (refused while any client is still attached, so no
# qube ever loses its netvm as a side effect), then wgq-mgmt, then the
# template (only if nothing else uses it), then the policy grant. The
# reviewed tree in /srv/salt is left for you to delete by hand -- the
# uninstaller does not remove the evidence of what it was.

set -eu

PROG=${0##*/}
TPL=${WGQ_TEMPLATE:-debian-13-wgq}

# note/ok/warn/die come from msg.sh, which sits beside this script.
case "$0" in */*) wgq_here=${0%/*} ;; *) wgq_here=. ;; esac
# shellcheck source=dom0/msg.sh
. "$wgq_here/msg.sh"

step() {
	printf '\n--> %s\nRun this step? [y = run / s = skip / q = stop] ' "$1"
	s_ans=""
	read -r s_ans || s_ans=q
	case "$s_ans" in
		y|yes) return 0 ;;
		s|skip) note "skipped"; return 1 ;;
		*) die "stopped; later steps not run" ;;
	esac
}

printf '%s: this walks the removal of everything wgq created. Type "uninstall" to begin: ' "$PROG"
ans=""
read -r ans || true
[ "$ans" = "uninstall" ] || die "confirmation did not match; nothing touched"

# Zones first; a zone with attached clients refuses, deliberately.
for fw in $(qvm-ls --raw-data --fields name 2>/dev/null | grep '^sys-fw-' || true); do
	zone=${fw#sys-fw-}
	vpn="sys-wgq-$zone"
	[ "$zone" = wgq ] && vpn=sys-wgq   # the single-VPN default zone
	clients=$(qvm-ls --raw-data --fields name,netvm 2>/dev/null \
		| awk -F'|' -v fw="$fw" '$2 == fw {print $1}' | tr '\n' ' ')
	if [ -n "${clients% }" ]; then
		die "zone '$zone' still has attached qubes: ${clients% }. Detach them first (wgq-zone detach <qube>), then re-run."
	fi
	if step "remove zone $zone (sys-fw-$zone + $vpn, including its private key)"; then
		qvm-shutdown --wait "sys-fw-$zone" "$vpn" 2>/dev/null || true
		qvm-remove -f "sys-fw-$zone"
		qvm-remove -f "$vpn"
		ok "zone $zone removed"
		note "revoke its registered key at the provider if it was provisioned"
	fi
done

if qvm-check --quiet wgq-mgmt 2>/dev/null; then
	if step "remove wgq-mgmt (holds the provider account credential file)"; then
		qvm-shutdown --wait wgq-mgmt 2>/dev/null || true
		qvm-remove -f wgq-mgmt
	fi
fi

if qvm-check --quiet "$TPL" 2>/dev/null; then
	users=$(qvm-ls --raw-data --fields name,template 2>/dev/null \
		| awk -F'|' -v t="$TPL" '$2 == t {print $1}' | tr '\n' ' ')
	if [ -n "${users% }" ]; then
		warn "template $TPL still backs: ${users% } -- leaving it in place"
	elif step "remove template $TPL"; then
		qvm-remove -f "$TPL"
	fi
fi

if [ -L /usr/local/bin/wgq ]; then
	if step "remove the dom0 entrypoint /usr/local/bin/wgq"; then
		rm -f /usr/local/bin/wgq
	fi
fi

ICON_DIR=/usr/local/share/icons/hicolor/scalable/apps
if [ -e "$ICON_DIR/servicevm-wgq.svg" ] \
	|| qubesd-query --fail -e dom0 admin.label.Get dom0 wgq >/dev/null 2>&1; then
	if step "remove the wgq identity (custom labels wgq/wgq-fw/wgq-mgmt and the icon files)"; then
		rm -f "$ICON_DIR/servicevm-wgq.svg" "$ICON_DIR/servicevm-wgq-fw.svg" \
			"$ICON_DIR/appvm-wgq-mgmt.svg"
		gtk-update-icon-cache -f -t /usr/local/share/icons/hicolor 2>/dev/null || true
		for l in wgq wgq-fw wgq-mgmt; do
			if qubesd-query --fail -e dom0 admin.label.Get dom0 "$l" >/dev/null 2>&1; then
				qubesd-query --fail -e dom0 admin.label.Remove dom0 "$l" >/dev/null 2>&1 \
					|| warn "label $l not removed; a qube still wears it"
			fi
		done
	fi
fi

if [ -f /etc/qubes/policy.d/30-wgq.policy ]; then
	if step "remove the qrexec grant /etc/qubes/policy.d/30-wgq.policy"; then
		rm -f /etc/qubes/policy.d/30-wgq.policy
	fi
fi

printf '\n'
ok "done. The reviewed tree remains; remove it yourself with:"
printf '    sudo rm -r /srv/salt/wgq /srv/salt/.ingest-receipts/wgq\n'
