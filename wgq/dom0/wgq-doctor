#!/bin/sh
#
# wgq-doctor - every invariant the debugging sessions checked by hand,
# checked mechanically, read-only, with a fix command on every failure.
#
#     sudo wgq doctor
#
# Three days of hardware bring-up were spent hand-verifying the same
# facts over and over: icons on disk, policies present, tags stamped,
# the chain wired client -> sys-fw -> sys-wgq, the kill switch landed,
# the accel fast path absent. Every one is mechanically checkable, so
# this command checks them all. It never mutates anything: doctor
# diagnoses, the printed fix commands (and the converge) heal.
#
# Exit status: 0 when nothing failed. Notes and skipped probes (a
# halted qube cannot be probed) do not fail the run; broken invariants
# do.

set -eu

PROG=${WGQ_PROG:-${0##*/}}
case "$0" in */*) wgq_here=${0%/*} ;; *) wgq_here=. ;; esac
# shellcheck source=dom0/msg.sh
. "$wgq_here/msg.sh"

# Fixed install locations, overridable only for the test harness.
ICON_DIR=${WGQ_ICON_DIR:-/usr/share/icons/hicolor/scalable/apps}
POLICY_DIR=${WGQ_POLICY_DIR:-/etc/qubes/policy.d}
SALT_DIR=${WGQ_SALT_DIR:-/srv/salt/wgq}
ENTRY=${WGQ_ENTRY:-/usr/local/bin/wgq}
TEMPLATE=${WGQ_TEMPLATE:-debian-13-wgq}

json=0
[ "${1:-}" = --json ] && json=1
[ $# -le 1 ] || {
	printf 'usage: %s [--json]\n' "$PROG" >&2
	exit 2
}

ok_n=0 fail_n=0 note_n=0 skip_n=0
records=$(mktemp)
trap 'rm -f "$records"' EXIT INT TERM

# Doctor is SCANNED, not read: the verdict lives in a fixed left gutter
# (painted on a tty, plain words in a pipe), the prose after it. Rows
# also land in a record file so --json can emit the same findings as
# one machine document.
gutter() {
	if colour_to 1; then
		case "$1" in
			ok) printf '\033[32m%-5s\033[0m' ok ;;
			FAIL) printf '\033[31m%-5s\033[0m' FAIL ;;
			skip) printf '\033[2m%-5s\033[0m' skip ;;
			*) printf '%-5s' "$1" ;;
		esac
	else
		printf '%-5s' "$1"
	fi
}
emit() { # emit <ok|FAIL|note|skip> <section> <text> [fix] [painted-section]
	case "$1" in
		ok) ok_n=$((ok_n + 1)) ;;
		FAIL) fail_n=$((fail_n + 1)) ;;
		note) note_n=$((note_n + 1)) ;;
		skip) skip_n=$((skip_n + 1)) ;;
	esac
	printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-}" \
		| tr -d '\000-\010\013\014\016-\037' >>"$records"
	[ "$json" -eq 1 ] && return 0
	printf '%s %-10s %s\n' "$(gutter "$1")" "${5:-$2}" "$3"
	[ -z "${4:-}" ] || printf '      %-10s fix:  %s\n' '' "$4"
}
row() { emit ok "$1" "$2"; }
bad() { emit FAIL "$1" "$2" "$3"; }

is_ours() {
	qvm-tags "$1" list 2>/dev/null | grep -qx created-by-wgq && return 0
	case "$(qvm-prefs "$1" label 2>/dev/null)" in
		wgq | wgq-fw | wgq-mgmt | wgq-tpl) return 0 ;;
	esac
	return 1
}

# The zone qube may be probed only when it is running AND qvm-run is
# available; anything else is a skip, never a guess.
vpn_probe() { # vpn_probe <qube> <command>
	command -v qvm-run >/dev/null 2>&1 || return 9
	qvm-run --no-gui --pass-io -u root -- "$1" "$2" 2>/dev/null
}

# -- identity: what the install put on disk ---------------------------------

icons_present=0
icons_total=0
for icon in appvm-wgq appvm-wgq-fw appvm-wgq-mgmt \
	servicevm-wgq servicevm-wgq-fw templatevm-wgq-tpl; do
	icons_total=$((icons_total + 1))
	[ -f "$ICON_DIR/$icon.svg" ] && icons_present=$((icons_present + 1))
done
if [ "$icons_present" -eq "$icons_total" ]; then
	row identity "icons $icons_present/$icons_total"
else
	bad identity "icons $icons_present/$icons_total in $ICON_DIR" \
		"sudo qubesctl --show-output state.apply wgq.wg-icons"
fi

policies_present=0
policies_total=0
for pol in 30-wgq 30-wgq-labels 30-wgq-creation; do
	policies_total=$((policies_total + 1))
	[ -f "$POLICY_DIR/$pol.policy" ] && policies_present=$((policies_present + 1))
done
if [ "$policies_present" -eq "$policies_total" ]; then
	row identity "policies $policies_present/$policies_total"
else
	bad identity "policies $policies_present/$policies_total in $POLICY_DIR" \
		"sudo airlock apply wgq"
fi

if [ -d "$SALT_DIR" ] && [ -e "$ENTRY" ]; then
	row tree "$SALT_DIR present, $ENTRY wired"
elif [ ! -d "$SALT_DIR" ]; then
	bad tree "no reviewed tree at $SALT_DIR" \
		"sudo airlock pull <qube> wgq <repo> && sudo airlock apply wgq"
else
	bad tree "$ENTRY missing or dangling" "sudo airlock apply wgq"
fi

if command -v fzf >/dev/null 2>&1; then
	emit note environment "fzf installed: pickers are fuzzy"
else
	emit note environment "fzf not installed; pickers use the numbered menu (optional: sudo qubes-dom0-update fzf)"
fi

# -- ownership: everything wearing our names is ours ------------------------

# One listing, taken once: a checker that cannot enumerate must say so,
# not hand out a clean bill on an empty list.
all_names=$(qvm-ls --raw-data --fields name 2>/dev/null) \
	|| die "qvm-ls failed; cannot examine anything (is qubesd running?)"
all_netvms=$(qvm-ls --raw-data --fields name,netvm 2>/dev/null) || all_netvms=''
all_templates=$(qvm-ls --raw-data --fields name,template 2>/dev/null) || all_templates=''

for qube in $(printf '%s\n' "$all_names" \
	| grep -E '^(sys-wgq|sys-fw-|wgq-mgmt$)' || true); do
	if is_ours "$qube"; then
		row ownership "$qube tagged"
	else
		# The same stance as zone list: a lookalike is surfaced, not
		# seized and not failed -- it is simply not ours to judge.
		emit note ownership "$qube wears a wgq name but was NOT created by wgq (ignored)"
	fi
done

# -- zones: the chain, and the dataplane inside it --------------------------

zones=0
for fw in $(printf '%s\n' "$all_names" | grep '^sys-fw-' || true); do
	is_ours "$fw" || continue
	zones=$((zones + 1))
	zone=${fw#sys-fw-}
	vpn="sys-wgq-$zone"
	[ "$zone" = wgq ] && vpn=sys-wgq
	sect="zone $zone"
	[ "$zone" = wgq ] && emit note "$sect" \
		"the reserved zone is deprecated: sudo wgq zone rename wgq <name> (bare-name support ends in 0.4.0)"

	if ! qvm-check --quiet "$vpn" 2>/dev/null; then
		bad "$sect" "$fw exists but $vpn does not; the zone is half gone" \
			"sudo wgq zone add $zone   (recreates and reconverges the pair)"
		continue
	fi

	fw_netvm=$(qvm-prefs "$fw" netvm 2>/dev/null || :)
	if [ "$fw_netvm" = "$vpn" ]; then
		uplink=$(qvm-prefs "$vpn" netvm 2>/dev/null || :)
		case "$uplink" in
			sys-fw-*) row "$sect" "chain $fw -> $vpn -> $uplink (chained through zone ${uplink#sys-fw-})" ;;
			*) row "$sect" "chain $fw -> $vpn -> ${uplink:-?}" ;;
		esac
	else
		bad "$sect" "$fw routes to '${fw_netvm:-nothing}', not $vpn: clients bypass the tunnel path" \
			"qvm-prefs $fw netvm $vpn"
	fi

	clients=$(printf '%s\n' "$all_netvms" \
		| awk -F'|' -v fw="$fw" '$2 == fw {print $1}' | tr '\n' ' ')
	emit note "$sect" "clients: ${clients:-none}"

	# Settings: features are the truth, the dataplane holds copies --
	# an explicit truth contradicted by its copy is drift worth failing.
	d_auto=$(qvm-features "$vpn" wgq.autoconnect 2>/dev/null || :)
	[ -n "$d_auto" ] || d_auto=$(qvm-features dom0 wgq.autoconnect 2>/dev/null || :)
	d_flag=$(qvm-features "$vpn" service.wgq-no-autoconnect 2>/dev/null || :)
	if [ "$d_auto" = off ] && [ "$d_flag" != 1 ]; then
		bad "$sect" "autoconnect is set off but the boot flag is not materialized" \
			"sudo wgq -z $zone connect   (or: sudo wgq -z $zone set autoconnect off)"
	elif [ "$d_auto" = on ] && [ "$d_flag" = 1 ]; then
		bad "$sect" "autoconnect is set on but the boot flag still seals the zone" \
			"sudo wgq -z $zone connect"
	elif [ "$d_flag" = 1 ]; then
		emit note "$sect" "autoconnect off: boots sealed until an explicit connect"
	fi

	template=$(printf '%s\n' "$all_templates" \
		| awk -F'|' -v v="$vpn" '$1 == v {print $2}')
	if [ -n "$template" ] && [ "$template" != "$TEMPLATE" ]; then
		emit note "$sect" "$vpn runs template '$template', expected $TEMPLATE"
	fi

	if ! qvm-check --quiet --running "$vpn" 2>/dev/null; then
		emit skip "$sect" "$vpn halted; dataplane checks skipped (start it and re-run)"
		continue
	fi

	state=$(vpn_probe "$vpn" 'cat /run/wgq/state') && rc=0 || rc=$?
	if [ "$rc" -eq 9 ]; then
		emit skip "$sect" "no qvm-run here; dataplane checks skipped"
		continue
	fi
	case "$state" in
		ok\ peer=*)
			row "$sect" "firewall state: $state"
			;;
		broken:*)
			bad "$sect" "firewall state is '$state': the qube sealed itself" \
				"sudo wgq -z $zone switch <peer>   (and read: sudo wgq logs $zone)"
			;;
		degraded:*)
			bad "$sect" "firewall state is '$state': clients have no DNS" \
				"sudo wgq -z $zone set dns <ip>   (or switch to a peer with a resolver)"
			;;
		*)
			# Missing state on a RUNNING marked qube means the firewall
			# script never finished -- the case where the checks below
			# matter most, so they run regardless.
			bad "$sect" "/run/wgq/state unreadable (missing, or $vpn gave no answer)" \
				"qvm-run -u root $vpn 'systemctl restart qubes-firewall'; then re-run doctor"
			;;
	esac

	if vpn_probe "$vpn" 'nft list chain ip qubes custom-forward' \
		| grep -q 'oifname != "wg0"'; then
		row "$sect" "kill switch installed"
	else
		bad "$sect" "kill switch rules NOT in custom-forward" \
			"qvm-run -u root $vpn 'systemctl restart qubes-firewall'"
	fi

	accel=$(vpn_probe "$vpn" \
		'nft list table inet qubes-nat-accel >/dev/null 2>&1 && echo present || echo absent' || :)
	case "$accel" in
		absent) row "$sect" "accel fast path absent" ;;
		present)
			bad "$sect" "the qubes-nat-accel fast path EXISTS: offloaded flows would bypass the kill switch" \
				"qvm-run -u root $vpn 'systemctl restart qubes-firewall'"
			;;
		*)
			bad "$sect" "could not check the accel fast path ($vpn gave no answer)" \
				"re-run doctor; if it persists: qvm-run -u root $vpn 'nft list tables'"
			;;
	esac

	if vpn_probe "$vpn" 'test -x /rw/config/network-hooks.d/90-wgq-no-accel'; then
		row "$sect" "no-accel hook present"
	else
		bad "$sect" "no-accel hook missing: the fast path returns on the next vif event" \
			"qvm-run -u root $vpn 'systemctl restart qubes-firewall'"
	fi

	d_dns=$(qvm-features "$vpn" wgq.dns 2>/dev/null || :)
	[ -n "$d_dns" ] || d_dns=$(qvm-features dom0 wgq.dns 2>/dev/null || :)
	# Affirmative read: a failed probe must read as "could not check",
	# never as drift -- convicting on an error is the dig bug's shape.
	d_file=$(vpn_probe "$vpn" 'cat /rw/config/wg/dns 2>/dev/null || echo __none__' || :)
	if [ -z "$d_file" ]; then
		emit skip "$sect" "could not check the resolver copy ($vpn gave no answer); re-run doctor"
	else
		[ "$d_file" = __none__ ] && d_file=''
		if [ "${d_dns:-}" != "${d_file:-}" ]; then
			bad "$sect" "stored resolver ('${d_dns:-provider}') and dataplane copy ('${d_file:-provider}') differ" \
				"sudo wgq -z $zone connect   (re-materializes the settings)"
		elif [ -n "$d_dns" ]; then
			row "$sect" "resolver override $d_dns materialized"
		fi
	fi
done
[ "$zones" -gt 0 ] || emit note zones "none exist; create one with: sudo wgq zone add <zone>"

# -- verdict ----------------------------------------------------------------

if [ "$json" -eq 1 ]; then
	python3 -c '
import json, sys
rows = []
for line in open(sys.argv[1]):
    parts = line.rstrip("\n").split("\t")
    status, section, text, fix = (parts + ["", "", "", ""])[:4]
    row = {"status": status, "section": section, "text": text}
    if fix:
        row["fix"] = fix
    rows.append(row)
json.dump({"findings": rows, "broken": sum(r["status"] == "FAIL" for r in rows)}, sys.stdout, indent=2)
print()
' "$records"
	[ "$fail_n" -eq 0 ] && exit 0
	exit 1
fi
printf '\n'
if [ "$fail_n" -eq 0 ]; then
	ok "doctor: nothing broken ($ok_n ok · $note_n notes · $skip_n skipped)"
	exit 0
fi
die "doctor: $fail_n broken invariant(s); each has its fix above ($ok_n ok · $note_n notes · $skip_n skipped)"
