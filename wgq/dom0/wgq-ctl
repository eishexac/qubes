#!/bin/sh
#
# wgq-ctl - the connection lifecycle and per-zone settings, from dom0.
#
#     sudo wgq [-z <zone>] connect
#     sudo wgq [-z <zone>] disconnect
#     sudo wgq [-z <zone>] set autoconnect on|off
#     sudo wgq [-z <zone>] set dns <ipv4>|default
#     sudo wgq [-z <zone>] get
#
# One invariant, said plainly every time it matters: DISCONNECTED MEANS
# DARK. The kill switch is installed by the firewall script regardless
# of tunnel state, so a disconnected zone's clients get nothing -- never
# clear traffic. `disconnect` is a pause button, not a bypass.
#
# Autoconnect is the default. Turning it off makes the zone boot sealed
# (exactly like an unconfigured qube: forwarding refused) until an
# explicit `wgq connect` -- the configure-first-connect-later flow.
#
# Settings are LAYERED: a global default (a feature on dom0) under a
# per-zone override (the same feature on the zone's VPN qube); the
# override wins, the built-in default backs both. Features are the
# single source of truth -- what the dataplane reads (the qubes-service
# flag, /rw/config/wg/dns) is a MATERIALIZED COPY, pushed at set and
# connect, and doctor checks the copy against the truth. `get` names
# the layer every value came from, so the layering stays honest.

# The global-set fan-out rebinds vpn/zone inside a subshell ON PURPOSE:
# each zone materializes under its own names and the outer zone's stay
# untouched -- exactly what these two findings warn might be an accident.
# shellcheck disable=SC2030,SC2031
set -eu

PROG=${WGQ_PROG:-${0##*/}}
case "$0" in */*) wgq_here=${0%/*} ;; *) wgq_here=. ;; esac
# shellcheck source=dom0/msg.sh
. "$wgq_here/msg.sh"

usage() {
	printf 'usage: %s connect | disconnect | set [--global] autoconnect on|off | set [--global] dns <ipv4>|default | get\n' "$PROG" >&2
	exit 2
}

# No default zone -- the dispatcher always supplies one; a direct
# invocation must too ("never a guess" applies to tools as much as
# humans).
zone=''
case "${1:-}" in
	-z | --zone)
		[ $# -ge 2 ] || usage
		zone=$2
		shift 2
		;;
esac
case "$zone" in
	-) ;; # the no-zone sentinel, validated against the verb below
	'') die "a zone is required: $PROG --zone <zone> <verb> (the wgq dispatcher supplies it)" ;;
	*[!a-z0-9-]* | -*) die "unusable zone name '$zone'" ;;
esac
vpn="sys-wgq-$zone"
[ "$zone" = wgq ] && vpn=sys-wgq

[ $# -ge 1 ] || usage
verb=$1
shift

# `--zone -` means "no zone context": legal ONLY for the global layer,
# where the write lands on dom0 and fans out -- there is no single
# subject qube to check. Everything else needs a real zone.
if [ "$zone" = - ]; then
	{ [ "$verb" = set ] && [ "${1:-}" = --global ]; } \
		|| die "a zone is required for '$verb' (only 'set --global' works without one)"
else
	qvm-check --quiet "$vpn" 2>/dev/null || die "zone '$zone' does not exist"
fi

is_ours() {
	qvm-tags "$1" list 2>/dev/null | grep -qx created-by-wgq && return 0
	case "$(qvm-prefs "$1" label 2>/dev/null)" in
		wgq | wgq-fw | wgq-mgmt | wgq-tpl) return 0 ;;
	esac
	return 1
}
[ "$zone" = - ] || is_ours "$vpn" || die "$vpn was not created by wgq; refusing to drive it"

# --no-autostart everywhere: only `connect` may bring the qube up, and
# it does so explicitly. A status read or a disconnect that BOOTS the
# zone (and, with autoconnect on, establishes the tunnel) would be the
# tool contradicting its own verbs.
vpn_root() {
	trace "-> qvm-run -u root $vpn: $*"
	qvm-run --no-gui --no-autostart --pass-io -u root -- "$vpn" "$*"
}

vpn_running() {
	qvm-check --quiet --running "$vpn" 2>/dev/null
}

is_ipv4() {
	# No empty octets (leading/trailing/double dots) and no leading
	# zeros: nft reads 010.1.1.1 as OCTAL, and a trailing dot fails the
	# whole nft transaction and seals the zone over a typo.
	case "$1" in
		'' | *[!0-9.]* | .* | *. | *..*) return 1 ;;
		0[0-9]* | *.0[0-9]*) return 1 ;;
	esac
	oldifs=$IFS
	IFS=.
	# shellcheck disable=SC2086 # deliberate word splitting on IFS
	set -- $1
	IFS=$oldifs
	[ $# -eq 4 ] || return 1
	for octet in "$@"; do
		[ -n "$octet" ] || return 1
		[ "$octet" -le 255 ] 2>/dev/null || return 1
	done
	return 0
}

# The effective value of one key: zone override, else global, else empty
# (the caller applies the built-in default).
effective() {
	e_v=$(qvm-features "$vpn" "wgq.$1" 2>/dev/null || :)
	if [ -n "$e_v" ]; then
		printf '%s' "$e_v"
	else
		qvm-features dom0 "wgq.$1" 2>/dev/null || :
	fi
}

layer_of() { # which layer answered: override | global | default
	if [ -n "$(qvm-features "$vpn" "wgq.$1" 2>/dev/null || :)" ]; then
		printf 'zone override'
	elif [ -n "$(qvm-features dom0 "wgq.$1" 2>/dev/null || :)" ]; then
		printf 'global'
	else
		printf 'default'
	fi
}

# Push the effective settings into the dataplane's copies. Safe to run
# any time the qube is up; a halted qube materializes at its next
# connect. No legacy import here, deliberately: a bare service flag
# cannot be told apart from one materialize itself wrote before the
# feature was cleared -- guessing would re-arm a flag the user just
# turned off. A pre-layering 'set autoconnect off' is re-run once.
materialize() {
	# Every write is explicitly guarded: inside the global fan-out's ||
	# context, errexit is OFF (POSIX: -e is ignored throughout a command
	# in an AND-OR list), so an unguarded failure would be silently
	# stepped over and the zone left stale while reporting success.
	if [ "$(effective autoconnect)" = off ]; then
		qvm-features "$vpn" service.wgq-no-autoconnect 1 \
			|| die "could not set the boot flag on $vpn; the setting is stored -- run: sudo wgq -z $zone connect"
	elif [ -n "$(qvm-features "$vpn" service.wgq-no-autoconnect 2>/dev/null || :)" ]; then
		qvm-features --unset "$vpn" service.wgq-no-autoconnect \
			|| die "could not clear the autoconnect flag on $vpn"
	fi
	vpn_running || return 0
	m_restarted=0
	m_dns=$(effective dns)
	if [ -n "$m_dns" ]; then
		is_ipv4 "$m_dns" || die "stored resolver '$m_dns' is not an IPv4 address; fix it: sudo wgq set dns <ip>"
		m_cur=$(vpn_root 'cat /rw/config/wg/dns' 2>/dev/null || :)
		if [ "$m_cur" != "$m_dns" ]; then
			vpn_root "mkdir -p /rw/config/wg && printf '%s\n' '$m_dns' > /rw/config/wg/dns" >/dev/null \
				|| die "could not write the resolver copy into $vpn; the setting is stored -- run: sudo wgq -z $zone connect"
			vpn_root 'systemctl restart qubes-firewall' >/dev/null \
				|| die "could not re-apply the firewall in $vpn -- run: sudo wgq doctor"
			m_restarted=1
		fi
	elif vpn_root 'test -f /rw/config/wg/dns' 2>/dev/null; then
		vpn_root 'rm -f /rw/config/wg/dns' >/dev/null \
			|| die "could not remove the resolver copy in $vpn -- run: sudo wgq -z $zone connect"
		vpn_root 'systemctl restart qubes-firewall' >/dev/null \
			|| die "could not re-apply the firewall in $vpn -- run: sudo wgq doctor"
		m_restarted=1
	fi
	# Read the result back whenever the firewall re-ran: a stored
	# resolver that kills client DNS must fail HERE, not at the next
	# doctor run.
	if [ "$m_restarted" -eq 1 ]; then
		m_state=$(vpn_root 'cat /run/wgq/state' 2>/dev/null || :)
		case "$m_state" in
			ok\ *) ;;
			degraded:*) die "firewall re-applied in $vpn but reports '$m_state': forwarding is up and clients have NO DNS until a usable resolver is set" ;;
			*) die "firewall re-apply in $vpn reports '${m_state:-nothing}'; the zone sealed itself -- run: sudo wgq doctor" ;;
		esac
	fi
}

case "$verb" in
	materialize)
		# Hidden verb: zone add calls it so a newborn zone inherits the
		# globals from its first boot, not its first hand-tuning.
		[ $# -eq 0 ] || usage
		materialize
		;;
	connect)
		[ $# -eq 0 ] || usage
		qvm-check --quiet --running "$vpn" 2>/dev/null || {
			note "$vpn is halted; starting it"
			qvm-start "$vpn"
		}
		materialize
		vpn_root 'systemctl start wg-tunnel' >/dev/null
		state=$(vpn_root 'cat /run/wgq/state' 2>/dev/null || :)
		case "$state" in
			ok\ peer=*) ok "zone $zone connected ($state)" ;;
			*) die "tunnel started but the zone reports '${state:-nothing}'; run: sudo wgq doctor" ;;
		esac
		;;
	disconnect)
		[ $# -eq 0 ] || usage
		if ! vpn_running; then
			ok "zone $zone is already dark ($vpn is halted)"
			exit 0
		fi
		vpn_root 'systemctl stop wg-tunnel' >/dev/null
		ok "zone $zone is dark: the kill switch holds, clients get nothing until: sudo wgq -z $zone connect"
		;;
	set)
		layer=zone
		if [ "${1:-}" = --global ]; then
			layer=global
			shift
		fi
		[ $# -eq 2 ] || usage
		key=$1
		value=$2
		case "$key" in
			autoconnect)
				case "$value" in on | off | default) ;; *) die "autoconnect is on, off or default, not '$value'" ;; esac
				;;
			dns)
				if [ "$value" != default ]; then
					is_ipv4 "$value" || die "'$value' is not an IPv4 address (or 'default')"
				fi
				;;
			*) die "unknown setting '$key' (autoconnect, dns)" ;;
		esac
		# Store at the named layer; 'default' clears that layer so the
		# one beneath answers again. An explicit value is stored even
		# when it matches the layer below: 'set autoconnect on' on one
		# zone must be able to beat a global 'off'.
		target=$vpn
		[ "$layer" = global ] && target=dom0
		if [ "$value" = default ]; then
			if [ -n "$(qvm-features "$target" "wgq.$key" 2>/dev/null || :)" ]; then
				qvm-features --unset "$target" "wgq.$key" \
					|| die "could not clear wgq.$key on $target"
			fi
			ok "$layer $key cleared; the $([ "$layer" = zone ] && printf 'global (or built-in) default' || printf 'built-in default') answers now"
		else
			qvm-features "$target" "wgq.$key" "$value"
			ok "$layer $key = $value"
		fi
		case "$key" in
			autoconnect) note "boot behavior changes from the next start of the affected zone(s)" ;;
			dns) [ "$value" != default ] \
				&& note "that resolver is reached THROUGH the tunnel: if it does not answer there, clients get no DNS rather than a leak" ;;
		esac
		# Materialize: this zone for a zone-set; every owned zone without
		# its own override for a global-set (halted zones catch up at
		# their next connect).
		if [ "$layer" = zone ]; then
			materialize
		else
			for m_fw in $(qvm-ls --raw-data --fields name 2>/dev/null | grep '^sys-fw-' || true); do
				is_ours "$m_fw" || continue
				m_zone=${m_fw#sys-fw-}
				m_vpn="sys-wgq-$m_zone"
				[ "$m_zone" = wgq ] && m_vpn=sys-wgq
				qvm-check --quiet "$m_vpn" 2>/dev/null || continue
				if [ -n "$(qvm-features "$m_vpn" "wgq.$key" 2>/dev/null || :)" ]; then
					note "zone $m_zone keeps its own $key override"
					continue
				fi
				(
					vpn=$m_vpn
					zone=$m_zone
					materialize
				) || warn "zone $m_zone did not materialize; run: sudo wgq -z $m_zone connect"
			done
		fi
		;;
	get)
		[ $# -eq 0 ] || usage
		g_auto=$(effective autoconnect)
		printf 'autoconnect: %s (%s)%s\n' "${g_auto:-on}" "$(layer_of autoconnect)" \
			"$([ "${g_auto:-on}" = off ] && printf ' -- boots sealed until connect')"
		g_dns=$(effective dns)
		printf 'dns:         %s (%s)\n' "${g_dns:-provider resolver}" "$(layer_of dns)"
		if vpn_running; then
			g_file=$(vpn_root 'cat /rw/config/wg/dns 2>/dev/null || echo __none__' 2>/dev/null || :)
			[ "$g_file" = __none__ ] && g_file=''
			if [ -n "${g_file}${g_dns}" ] && [ "${g_file:-}" != "${g_dns:-}" ]; then
				warn "dataplane copy ('${g_file:-none}') differs from the stored value; run: sudo wgq -z $zone connect"
			fi
			printf 'tunnel:      %s\n' "$(vpn_root 'cat /run/wgq/state' 2>/dev/null || printf unknown)"
		else
			printf 'tunnel:      %s halted (settings apply at next connect)\n' "$vpn"
		fi
		;;
	*) usage ;;
esac
