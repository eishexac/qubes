#!/bin/sh
#
# wgq-ctl - the connection lifecycle and per-zone settings, from dom0.
#
#     sudo wgq [-z <zone>] connect
#     sudo wgq [-z <zone>] disconnect
#     sudo wgq [-z <zone>] set autoconnect on|off
#     sudo wgq [-z <zone>] set dns <ipv4>|default
#     sudo wgq [-z <zone>] get
#
# One invariant, said plainly every time it matters: DISCONNECTED MEANS
# DARK. The kill switch is installed by the firewall script regardless
# of tunnel state, so a disconnected zone's clients get nothing -- never
# clear traffic. `disconnect` is a pause button, not a bypass.
#
# Autoconnect is the default. Turning it off makes the zone boot sealed
# (exactly like an unconfigured qube: forwarding refused) until an
# explicit `wgq connect` -- the configure-first-connect-later flow. The
# flag is a Qubes per-qube service feature, so it survives reboots and
# template updates and is visible in qvm-features like any other.

set -eu

PROG=${WGQ_PROG:-${0##*/}}
case "$0" in */*) wgq_here=${0%/*} ;; *) wgq_here=. ;; esac
# shellcheck source=dom0/msg.sh
. "$wgq_here/msg.sh"

usage() {
	printf 'usage: %s connect | disconnect | set autoconnect on|off | set dns <ipv4>|default | get\n' "$PROG" >&2
	exit 2
}

zone=wgq
case "${1:-}" in
	-z | --zone)
		[ $# -ge 2 ] || usage
		zone=$2
		shift 2
		;;
esac
case "$zone" in
	'' | *[!a-z0-9-]* | -*) die "unusable zone name '$zone'" ;;
esac
vpn="sys-wgq-$zone"
[ "$zone" = wgq ] && vpn=sys-wgq

[ $# -ge 1 ] || usage
verb=$1
shift

qvm-check --quiet "$vpn" 2>/dev/null || die "zone '$zone' does not exist"

is_ours() {
	qvm-tags "$1" list 2>/dev/null | grep -qx created-by-wgq && return 0
	case "$(qvm-prefs "$1" label 2>/dev/null)" in
		wgq | wgq-fw | wgq-mgmt | wgq-tpl) return 0 ;;
	esac
	return 1
}
is_ours "$vpn" || die "$vpn was not created by wgq; refusing to drive it"

# --no-autostart everywhere: only `connect` may bring the qube up, and
# it does so explicitly. A status read or a disconnect that BOOTS the
# zone (and, with autoconnect on, establishes the tunnel) would be the
# tool contradicting its own verbs.
vpn_root() {
	trace "-> qvm-run -u root $vpn: $*"
	qvm-run --no-gui --no-autostart --pass-io -u root -- "$vpn" "$*"
}

vpn_running() {
	qvm-check --quiet --running "$vpn" 2>/dev/null
}

is_ipv4() {
	# No empty octets (leading/trailing/double dots) and no leading
	# zeros: nft reads 010.1.1.1 as OCTAL, and a trailing dot fails the
	# whole nft transaction and seals the zone over a typo.
	case "$1" in
		'' | *[!0-9.]* | .* | *. | *..*) return 1 ;;
		0[0-9]* | *.0[0-9]*) return 1 ;;
	esac
	oldifs=$IFS
	IFS=.
	# shellcheck disable=SC2086 # deliberate word splitting on IFS
	set -- $1
	IFS=$oldifs
	[ $# -eq 4 ] || return 1
	for octet in "$@"; do
		[ -n "$octet" ] || return 1
		[ "$octet" -le 255 ] 2>/dev/null || return 1
	done
	return 0
}

case "$verb" in
	connect)
		[ $# -eq 0 ] || usage
		qvm-check --quiet --running "$vpn" 2>/dev/null || {
			note "$vpn is halted; starting it"
			qvm-start "$vpn"
		}
		vpn_root 'systemctl start wg-tunnel' >/dev/null
		state=$(vpn_root 'cat /run/wgq/state' 2>/dev/null || :)
		case "$state" in
			ok\ peer=*) ok "zone $zone connected ($state)" ;;
			*) die "tunnel started but the zone reports '${state:-nothing}'; run: sudo wgq doctor" ;;
		esac
		;;
	disconnect)
		[ $# -eq 0 ] || usage
		if ! vpn_running; then
			ok "zone $zone is already dark ($vpn is halted)"
			exit 0
		fi
		vpn_root 'systemctl stop wg-tunnel' >/dev/null
		ok "zone $zone is dark: the kill switch holds, clients get nothing until: sudo wgq -z $zone connect"
		;;
	set)
		[ $# -eq 2 ] || usage
		key=$1
		value=$2
		case "$key" in
			autoconnect)
				case "$value" in
					off)
						qvm-features "$vpn" service.wgq-no-autoconnect 1
						ok "zone $zone will boot sealed (tunnel down, forwarding refused) until an explicit connect"
						;;
					on)
						if [ -n "$(qvm-features "$vpn" service.wgq-no-autoconnect 2>/dev/null || :)" ]; then
							qvm-features --unset "$vpn" service.wgq-no-autoconnect \
								|| die "could not clear the autoconnect flag on $vpn"
						fi
						ok "zone $zone connects at boot again (the default)"
						;;
					*) die "autoconnect is on or off, not '$value'" ;;
				esac
				note "takes effect from the next start of $vpn"
				;;
			dns)
				vpn_running || die "$vpn is halted; start the zone first: sudo wgq -z $zone connect"
				if [ "$value" = default ]; then
					vpn_root 'rm -f /rw/config/wg/dns' >/dev/null
					ok "zone $zone resolver override removed; the provider resolver is pinned again"
				else
					is_ipv4 "$value" || die "'$value' is not an IPv4 address (or 'default')"
					vpn_root "mkdir -p /rw/config/wg && printf '%s\\n' '$value' > /rw/config/wg/dns" >/dev/null
					ok "zone $zone client DNS will be pinned to $value"
					note "that resolver is reached THROUGH the tunnel: if it does not answer there, clients get no DNS rather than a leak"
					note "an off-provider resolver is a fingerprinting and trust trade-off; the provider default avoids it"
				fi
				# The pin lives in the firewall script; re-run it and let it
				# read its own work back.
				vpn_root 'systemctl restart qubes-firewall' >/dev/null
				state=$(vpn_root 'cat /run/wgq/state' 2>/dev/null || :)
				case "$state" in
					ok\ *) ok "firewall re-applied ($state)" ;;
					degraded:*) die "firewall re-applied but reports '$state': forwarding is up and clients have NO DNS until a usable resolver is set" ;;
					*) die "firewall re-apply reports '${state:-nothing}'; the zone sealed itself -- run: sudo wgq doctor" ;;
				esac
				;;
			*) die "unknown setting '$key' (autoconnect, dns)" ;;
		esac
		;;
	get)
		[ $# -eq 0 ] || usage
		if [ "$(qvm-features "$vpn" service.wgq-no-autoconnect 2>/dev/null || :)" = 1 ]; then
			printf 'autoconnect: off (boots sealed until connect)\n'
		else
			printf 'autoconnect: on\n'
		fi
		if vpn_running; then
			override=$(vpn_root 'cat /rw/config/wg/dns' 2>/dev/null || :)
			printf 'dns:         %s\n' "${override:-provider default}"
			printf 'tunnel:      %s\n' "$(vpn_root 'cat /run/wgq/state' 2>/dev/null || printf unknown)"
		else
			printf 'dns:         (unknown: %s is halted)\n' "$vpn"
			printf 'tunnel:      %s halted\n' "$vpn"
		fi
		;;
	*) usage ;;
esac
