#!/bin/sh
#
# wgq (dom0) - one entrypoint for the whole tool, routed to where the
# work actually belongs.
#
#     wgq zone <verb> ...            the zone manager, in dom0 (sudo)
#     wgq uninstall                  the uninstaller, in dom0 (sudo)
#     wgq credential <provider>      store the account id in wgq-mgmt
#     wgq [-z <zone>] sync           peer bundle: wgq-mgmt -> VPN qube,
#                                    then `wgq apply` there
#     wgq [-z <zone>] <vpn verb> ..  runs `wgq <verb>` in the zone's VPN
#                                    qube (keygen apply switch: as root;
#                                    pubkey status: as user)
#     wgq <anything else> ...        runs `wgq ...` inside wgq-mgmt
#
# Always `sudo wgq ...`: the entrypoint is a symlink into /srv/salt,
# which is root-only on Qubes -- a user shell cannot stat the target,
# so PATH lookup reports the command as not found. Deliberate: the
# approved tree stays root's, and every verb here is dom0 authority.
#
# The default zone is the reserved singleton 'wgq', so on a single-VPN
# setup the whole lifecycle is dom0 one-liners:
#
#     sudo wgq credential ivpn
#     sudo wgq keygen
#     sudo wgq pubkey | sudo wgq provision --provider ivpn --zone wgq
#     sudo wgq sync
#     sudo wgq switch <peer>
#     sudo wgq firewall --zone wgq
#
# File arguments to proxied verbs cross into the target qube verbatim:
# give `apply` a path that exists THERE, not a dom0 path (or just use
# `sync`, which stages the bundle itself).
#
# dom0 never runs the wgq CLI itself -- the CLI refuses dom0, by design.
# This wrapper only frames qvm-run invocations you could type by hand,
# and prints each one before it runs, so nothing is hidden.

set -eu

PROG=${0##*/}
# Installed on PATH as a symlink into the reviewed tree; resolve it so
# the siblings (msg.sh, wgq-zone, wgq-uninstall) are found either way.
SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
case "$SELF" in */*) wgq_here=${SELF%/*} ;; *) wgq_here=. ;; esac
# shellcheck source=dom0/msg.sh
. "$wgq_here/msg.sh"

MGMT=${WGQ_MGMT:-wgq-mgmt}

usage() {
	printf 'usage: %s zone <verb> ...           (dom0: add attach detach list remove)\n' "$PROG" >&2
	printf '       %s panic [-z <zone>]         (EMERGENCY: kill + block every zone, or one)\n' "$PROG" >&2
	printf '       %s uninstall\n' "$PROG" >&2
	printf '       %s credential <provider>     (store the account id in %s)\n' "$PROG" "$MGMT" >&2
	printf '       %s [-z <zone>] sync          (peer bundle: %s -> VPN qube + apply)\n' "$PROG" "$MGMT" >&2
	printf '       %s [-z <zone>] keygen|pubkey|apply|switch|status ...\n' "$PROG" >&2
	printf '       %s <mgmt verb> ...           (servers provision peer firewall ...)\n' "$PROG" >&2
	exit 2
}

check_zone() {
	case "$1" in
		''|*[!a-z0-9-]*|-*) die "unusable zone name '$1' (lowercase, digits, dashes)" ;;
	esac
}

vpn_name() {
	if [ "$1" = wgq ]; then printf 'sys-wgq'; else printf 'sys-wgq-%s' "$1"; fi
}

# The emergency stop. Two actions per zone, in this order, straight from
# dom0 -- no prompt, no VM code trusted:
#   1. deny-all firewall on the zone's firewall qube. It is enforced in
#      sys-fw's OWN netvm, upstream, so it holds even against a fully
#      compromised zone, and it PERSISTS across restarts -- restarting a
#      qube cannot resurrect the tunnel behind your back.
#   2. kill the VPN qube. Instant: the only route ceases to exist, so
#      in-flight and future client packets have nowhere to go.
# Recovery is deliberate, never automatic: qvm-start the VPN qube, then
# `wgq firewall --zone <z>` to restore the real allowlist.
panic_zone() {
	p_zone=$1
	p_fw="sys-fw-$p_zone"
	p_vpn=$(vpn_name "$p_zone")
	if qvm-check --quiet "$p_fw" 2>/dev/null; then
		note "$p_zone: blocking $p_fw (deny-all, enforced upstream, survives restart)"
		qvm-firewall "$p_fw" reset 2>/dev/null || true
		qvm-firewall "$p_fw" set-policy drop 2>/dev/null \
			|| warn "$p_zone: could not set deny-all on $p_fw"
	fi
	if qvm-check --quiet "$p_vpn" 2>/dev/null; then
		note "$p_zone: killing $p_vpn"
		qvm-kill "$p_vpn" 2>/dev/null || warn "$p_zone: could not kill $p_vpn"
	fi
	ok "$p_zone: dark. Restore with: qvm-start $p_vpn && $PROG firewall --zone $p_zone"
}

cmd_panic() {
	# Accept -z after the verb too (`panic -z work`), the shape the
	# usage line advertises.
	case "${1:-}" in
		-z|--zone)
			[ $# -eq 2 ] || usage
			zone=$2; PANIC_ONE=1; shift 2 ;;
	esac
	[ $# -eq 0 ] || usage
	if [ "$PANIC_ONE" = 1 ]; then
		check_zone "$zone"
		zone_exists "$zone" || die "zone '$zone' does not exist"
		panic_zone "$zone"
		return 0
	fi
	# No -z: every zone, by NAME, deliberately unfiltered by the
	# created-by-wgq tag the lifecycle verbs check. An emergency stop
	# must fail closed: blocking a similarly-named stranger's qube is a
	# recoverable inconvenience, skipping a wgq qube that predates the
	# tag is an open line. Emergencies do not pause to enumerate.
	p_any=0
	for p_fw in $(qvm-ls --raw-data --fields name 2>/dev/null | grep '^sys-fw-' || true); do
		p_any=1
		panic_zone "${p_fw#sys-fw-}"
	done
	[ "$p_any" = 1 ] || warn "no wgq zones found; nothing to stop"
}

zone_exists() { qvm-check --quiet "sys-fw-$1" 2>/dev/null; }

# Single-quote an argument for the shell inside the target qube; the
# only character that can escape a single-quoted string is the quote
# itself, so that is the only one rewritten.
quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# run_in <qube> <user> <wgq args...> -- frame the qvm-run, show it, run it.
run_in() {
	r_qube=$1 r_user=$2
	shift 2
	r_cmd='wgq'
	for r_arg in "$@"; do
		r_cmd="$r_cmd $(quote "$r_arg")"
	done
	trace "-> qvm-run -u $r_user $r_qube $r_cmd"
	exec qvm-run --no-gui --pass-io -u "$r_user" -- "$r_qube" "$r_cmd"
}

zone=wgq
PANIC_ONE=0
while [ $# -gt 0 ]; do
	case "$1" in
		-z|--zone)
			[ $# -ge 2 ] || usage
			zone=$2
			PANIC_ONE=1
			shift 2 ;;
		-*) usage ;;
		*) break ;;
	esac
done
[ $# -ge 1 ] || usage
verb=$1

case "$verb" in
	panic)
		shift; cmd_panic "$@" ;;
	zone)
		shift
		# The sub-tool's own hints then name the command the operator
		# actually has on PATH.
		WGQ_PROG="$PROG zone" export WGQ_PROG
		exec "$wgq_here/wgq-zone" "$@" ;;
	uninstall)
		exec "$wgq_here/wgq-uninstall" ;;
	credential)
		# The secret is typed in dom0 and piped straight into the file
		# inside wgq-mgmt: it never touches a disk outside that qube.
		[ $# -eq 2 ] || usage
		provider=$2
		case "$provider" in
			''|*[!a-z0-9-]*) die "unusable provider name '$provider'" ;;
		esac
		printf '%s account id (input hidden): ' "$provider"
		stty -echo 2>/dev/null || true
		acct=""
		read -r acct || true
		stty echo 2>/dev/null || true
		printf '\n'
		[ -n "$acct" ] || die "empty account id; nothing written"
		# Written as root: /rw/config is root-owned inside every qube,
		# and dom0's qrexec runs as root by dom0's own authority -- no
		# in-qube sudo involved, so this works even on a mgmt qube with
		# passwordless root removed. Then handed to user, who is what
		# the management verbs run as and what the CLI's mode-600 check
		# expects to own the file.
		trace "-> qvm-run -u root $MGMT 'umask 077 && cat > /rw/config/$provider-account && chown user:user ...'"
		printf '%s\n' "$acct" | qvm-run --no-gui --pass-io -u root -- "$MGMT" \
			"umask 077 && cat > /rw/config/$provider-account && chown user:user /rw/config/$provider-account"
		ok "credential stored in $MGMT:/rw/config/$provider-account (mode 600, owner user)"
		exit 0 ;;
	sync)
		# The qvm-copy dance, framed: stream the bundle out of wgq-mgmt
		# and into the zone's VPN qube, then apply it there. The zone
		# name is validated above, so embedding it is safe.
		[ $# -eq 1 ] || usage
		check_zone "$zone"
		s_vpn=$(vpn_name "$zone")
		trace "-> qvm-run -u user $MGMT 'tar -C ~/.local/share/wgq/zones/$zone -cf - peers'"
		trace "   | qvm-run -u root $s_vpn 'tar -xf - && wgq apply peers'"
		qvm-run --no-gui --pass-io -u user -- "$MGMT" \
			"tar -C /home/user/.local/share/wgq/zones/$zone -cf - peers" \
		| qvm-run --no-gui --pass-io -u root -- "$s_vpn" \
			"rm -rf /tmp/wgq-sync && mkdir -p /tmp/wgq-sync && tar -xf - -C /tmp/wgq-sync && wgq apply /tmp/wgq-sync/peers && rm -rf /tmp/wgq-sync"
		exit 0 ;;
	keygen|apply|switch)
		check_zone "$zone"
		shift; run_in "$(vpn_name "$zone")" root "$verb" "$@" ;;
	pubkey|status)
		check_zone "$zone"
		shift; run_in "$(vpn_name "$zone")" user "$verb" "$@" ;;
	*)
		run_in "$MGMT" user "$@" ;;
esac
