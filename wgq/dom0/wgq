#!/bin/sh
#
# wgq (dom0) - one entrypoint for the whole tool, routed to where the
# work actually belongs.
#
#     wgq zone <verb> ...            the zone manager, in dom0 (sudo)
#     wgq uninstall                  the uninstaller, in dom0 (sudo)
#     wgq credential <provider>      store the account id in wgq-mgmt
#     wgq [-z <zone>] sync           peer bundle: wgq-mgmt -> VPN qube,
#                                    then `wgq apply` there
#     wgq [-z <zone>] <vpn verb> ..  runs `wgq <verb>` in the zone's VPN
#                                    qube (keygen apply switch: as root;
#                                    pubkey status: as user)
#     wgq <anything else> ...        runs `wgq ...` inside wgq-mgmt
#
# Always `sudo wgq ...`: the entrypoint is a symlink into /srv/salt,
# which is root-only on Qubes -- a user shell cannot stat the target,
# so PATH lookup reports the command as not found. Deliberate: the
# approved tree stays root's, and every verb here is dom0 authority.
#
# The default zone is the reserved singleton 'wgq', so on a single-VPN
# setup the whole lifecycle is dom0 one-liners:
#
#     sudo wgq credential ivpn
#     sudo wgq keygen
#     sudo wgq pubkey | sudo wgq provision --provider ivpn --zone wgq
#     sudo wgq sync
#     sudo wgq switch <peer>
#     sudo wgq firewall --zone wgq
#
# File arguments to proxied verbs cross into the target qube verbatim:
# give `apply` a path that exists THERE, not a dom0 path (or just use
# `sync`, which stages the bundle itself).
#
# dom0 never runs the wgq CLI itself -- the CLI refuses dom0, by design.
# This wrapper only frames qvm-run invocations you could type by hand,
# and prints each one before it runs, so nothing is hidden.

set -eu

PROG=${0##*/}
# Installed on PATH as a symlink into the reviewed tree; resolve it so
# the siblings (msg.sh, wgq-zone, wgq-uninstall) are found either way.
SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
case "$SELF" in */*) wgq_here=${SELF%/*} ;; *) wgq_here=. ;; esac
# shellcheck source=dom0/msg.sh
. "$wgq_here/msg.sh"

MGMT=${WGQ_MGMT:-wgq-mgmt}

usage() {
	printf 'usage: %s <command> [zone] ...      (no zone named? a picker asks -- never a guess)\n' "$PROG" >&2
	printf '       %s zone <verb> ...           (dom0: add attach detach list remove)\n' "$PROG" >&2
	printf '       %s panic [-z <zone>]         (EMERGENCY: kill + block every zone, or one)\n' "$PROG" >&2
	printf '       %s verify [zone] [--kill-rounds N]  (prove the zone leak-tight)\n' "$PROG" >&2
	printf '       %s doctor                    (check every wgq invariant, with fixes)\n' "$PROG" >&2
	printf '       %s tree                      (every zone: chain, health, colour, routes)\n' "$PROG" >&2
	printf '       %s top <zone> [--once]       (live: handshake, rates, kill-switch drops)\n' "$PROG" >&2
	printf '       %s restart [zone]            (offered shutdown/start cycle after updates)\n' "$PROG" >&2
	printf '       %s route [list|<role> <zone>|default]  (system traffic, your choice of zone)\n' "$PROG" >&2
	printf '       %s connect|disconnect [zone]  (aliases up|down; dark -- never clear)\n' "$PROG" >&2
	printf '       %s set [--global] [zone] autoconnect|dns <value>|default | get [zone]\n' "$PROG" >&2
	printf '       %s uninstall\n' "$PROG" >&2
	printf '       %s credential <provider>     (store the account id in %s)\n' "$PROG" "$MGMT" >&2
	printf '       %s sync [zone]               (peer bundle: %s -> VPN qube + apply)\n' "$PROG" "$MGMT" >&2
	printf '       %s keygen|pubkey|status [zone] | apply|switch [zone] <arg>\n' "$PROG" >&2
	printf '       %s <mgmt verb> ...           (servers provision peer firewall ...)\n' "$PROG" >&2
	printf '       -z <zone> is accepted anywhere and always means the same thing\n' >&2
	exit 2
}

check_zone() {
	case "$1" in
		'' | *[!a-z0-9-]* | -*) die "unusable zone name '$1' (lowercase, digits, dashes)" ;;
	esac
}

is_ours() {
	qvm-tags "$1" list 2>/dev/null | grep -qx created-by-wgq && return 0
	case "$(qvm-prefs "$1" label 2>/dev/null)" in
		wgq | wgq-fw | wgq-mgmt | wgq-tpl) return 0 ;;
	esac
	return 1
}

owned_zones() {
	for oz_fw in $(qvm-ls --raw-data --fields name 2>/dev/null | grep '^sys-fw-' || true); do
		is_ours "$oz_fw" || continue
		printf '%s\n' "${oz_fw#sys-fw-}"
	done
}

is_owned_zone() {
	case "$1" in '' | *[!a-z0-9-]* | -*) return 1 ;; esac
	owned_zones | grep -qx "$1"
}

# The idiom: a zone is NAMED or PICKED, never implied. No zone on the
# line and a terminal attached: the picker opens -- even with one zone,
# because choosing from a one-item list is an explicit act, and a
# command's behavior must not change the day a second zone appears.
# No terminal: refuse and list the zones; scripts get neither prompts
# nor guesses. pick_zone 1 allows multi-select (per-zone verbs).
pick_zone() {
	pz_zones=$(owned_zones)
	[ -n "$pz_zones" ] || die "no zones exist; create one with: $PROG zone add <name>"
	if [ ! -t 0 ] || [ ! -t 2 ]; then
		die "no zone named and no terminal to ask on. Zones: $(printf '%s' "$pz_zones" | tr '\n' ' ')"
	fi
	if command -v fzf >/dev/null 2>&1; then
		if [ "$1" = 1 ]; then
			printf '%s\n' "$pz_zones" \
				| fzf --multi --prompt='zone> ' --height=40% --reverse \
				|| die "no zone chosen"
		else
			printf '%s\n' "$pz_zones" \
				| fzf --prompt='zone> ' --height=40% --reverse \
				|| die "no zone chosen"
		fi
		return 0
	fi
	pz_i=0
	for pz in $pz_zones; do
		pz_i=$((pz_i + 1))
		pz_vpn="sys-wgq-$pz"
		[ "$pz" = wgq ] && pz_vpn=sys-wgq
		pz_c=$(qvm-features "$pz_vpn" wgq.color 2>/dev/null || :)
		printf '  %d) %s\n' "$pz_i" "$(paint_to 2 "$pz_c" "$pz")" >&2
	done
	if [ "$1" = 1 ]; then
		printf 'zone number(s), space-separated: ' >&2
	else
		printf 'zone number: ' >&2
	fi
	read -r pz_ans </dev/tty || die "no zone chosen"
	[ -n "$pz_ans" ] || die "no zone chosen"
	if [ "$1" != 1 ]; then
		case "$pz_ans" in *' '*) die "pick exactly one" ;; esac
	fi
	for pz_n in $pz_ans; do
		case "$pz_n" in '' | *[!0-9]*) die "not a number: '$pz_n'" ;; esac
		pz_sel=$(printf '%s\n' "$pz_zones" | sed -n "${pz_n}p")
		[ -n "$pz_sel" ] || die "no zone numbered $pz_n"
		printf '%s\n' "$pz_sel"
	done
}

# Consume $1 as a positional zone when it names an owned zone. Callers
# pass the minimum arg count the verb still needs afterwards, so
# `switch <peer>` never eats a peer that happens to share a zone's name.
# (Used inline: helpers cannot shift a caller's args in POSIX sh.)

vpn_name() {
	if [ "$1" = wgq ]; then printf 'sys-wgq'; else printf 'sys-wgq-%s' "$1"; fi
}

# The emergency stop. Two actions per zone, in this order, straight from
# dom0 -- no prompt, no VM code trusted:
#   1. deny-all firewall on the zone's firewall qube. It is enforced in
#      sys-fw's OWN netvm, upstream, so it holds even against a fully
#      compromised zone, and it PERSISTS across restarts -- restarting a
#      qube cannot resurrect the tunnel behind your back.
#   2. kill the VPN qube. Instant: the only route ceases to exist, so
#      in-flight and future client packets have nowhere to go.
# Recovery is deliberate, never automatic: qvm-start the VPN qube, then
# `wgq firewall --zone <z>` to restore the real allowlist.
panic_zone() {
	p_zone=$1
	p_fw="sys-fw-$p_zone"
	p_vpn=$(vpn_name "$p_zone")
	if qvm-check --quiet "$p_fw" 2>/dev/null; then
		note "$p_zone: blocking $p_fw (deny-all, enforced upstream, survives restart)"
		qvm-firewall "$p_fw" reset 2>/dev/null || true
		qvm-firewall "$p_fw" set-policy drop 2>/dev/null \
			|| warn "$p_zone: could not set deny-all on $p_fw"
	fi
	if qvm-check --quiet "$p_vpn" 2>/dev/null; then
		note "$p_zone: killing $p_vpn"
		qvm-kill "$p_vpn" 2>/dev/null || warn "$p_zone: could not kill $p_vpn"
	fi
	ok "$p_zone: dark. Restore with: qvm-start $p_vpn && $PROG firewall --zone $p_zone"
}

cmd_panic() {
	# Accept -z after the verb too (`panic -z work`), the shape the
	# usage line advertises.
	case "${1:-}" in
		-z | --zone)
			[ $# -eq 2 ] || usage
			zone=$2
			PANIC_ONE=1
			shift 2
			;;
	esac
	[ $# -eq 0 ] || usage
	if [ "$PANIC_ONE" = 1 ]; then
		check_zone "$zone"
		zone_exists "$zone" || die "zone '$zone' does not exist"
		panic_zone "$zone"
		return 0
	fi
	# No -z: every zone, by NAME, deliberately unfiltered by the
	# created-by-wgq tag the lifecycle verbs check. An emergency stop
	# must fail closed: blocking a similarly-named stranger's qube is a
	# recoverable inconvenience, skipping a wgq qube that predates the
	# tag is an open line. Emergencies do not pause to enumerate.
	p_any=0
	for p_fw in $(qvm-ls --raw-data --fields name 2>/dev/null | grep '^sys-fw-' || true); do
		p_any=1
		panic_zone "${p_fw#sys-fw-}"
	done
	[ "$p_any" = 1 ] || warn "no wgq zones found; nothing to stop"
}

zone_exists() { qvm-check --quiet "sys-fw-$1" 2>/dev/null; }

# Single-quote an argument for the shell inside the target qube; the
# only character that can escape a single-quoted string is the quote
# itself, so that is the only one rewritten.
quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# run_in <qube> <user> <wgq args...> -- frame the qvm-run, show it, run it.
run_in() {
	r_qube=$1 r_user=$2
	shift 2
	r_cmd='wgq'
	for r_arg in "$@"; do
		r_cmd="$r_cmd $(quote "$r_arg")"
	done
	trace "-> qvm-run -u $r_user $r_qube $r_cmd"
	exec qvm-run --no-gui --pass-io -u "$r_user" -- "$r_qube" "$r_cmd"
}

zone=''
PANIC_ONE=0
# `-z <zone>` is accepted ANYWHERE on the line: the zone is the
# sentence's subject, and word order must never change meaning --
# `wgq sync -z work` and `wgq -z work sync` are the same command.
# Only the short -z is collected globally: `--zone` AFTER a verb
# belongs to that verb's own CLI inside the qube (provision --zone ...
# passes through untouched); a LEADING --zone still addresses the
# dispatcher, as it always has.
pending_zone=0
rebuilt=0
for arg; do
	[ "$rebuilt" -eq 0 ] && {
		set --
		rebuilt=1
	}
	if [ "$pending_zone" -eq 1 ]; then
		zone=$arg PANIC_ONE=1 pending_zone=0
		continue
	fi
	case "$arg" in
		-z) pending_zone=1 ;;
		*) set -- "$@" "$arg" ;;
	esac
done
[ "$pending_zone" -eq 0 ] || usage
while [ $# -gt 0 ]; do
	case "$1" in
		--zone)
			[ $# -ge 2 ] || usage
			zone=$2
			PANIC_ONE=1
			shift 2
			;;
		-*) usage ;;
		*) break ;;
	esac
done
[ $# -ge 1 ] || usage
verb=$1

case "$verb" in
	panic)
		shift
		cmd_panic "$@"
		;;
	zone)
		shift
		# The sub-tool's own hints then name the command the operator
		# actually has on PATH.
		WGQ_PROG="$PROG zone" export WGQ_PROG
		exec "$wgq_here/wgq-zone" "$@"
		;;
	verify)
		shift
		if [ -z "$zone" ] && [ $# -ge 1 ] && is_owned_zone "$1"; then
			zone=$1
			shift
		fi
		WGQ_PROG="$PROG verify" export WGQ_PROG
		if [ -n "$zone" ]; then
			exec "$wgq_here/wgq-verify" --zone "$zone" "$@"
		fi
		v_rc=0
		for v_z in $(pick_zone 1); do
			"$wgq_here/wgq-verify" --zone "$v_z" "$@" || v_rc=1
		done
		exit "$v_rc"
		;;
	doctor)
		shift
		WGQ_PROG="$PROG doctor" export WGQ_PROG
		exec "$wgq_here/wgq-doctor" "$@"
		;;
	top)
		shift
		if [ -z "$zone" ] && [ $# -ge 1 ] && is_owned_zone "$1"; then
			zone=$1
			shift
		fi
		[ -n "$zone" ] || zone=$(pick_zone 0)
		WGQ_PROG="$PROG top" export WGQ_PROG
		exec "$wgq_here/wgq-top" "$zone" "$@"
		;;
	tree)
		shift
		WGQ_PROG="$PROG tree" export WGQ_PROG
		exec "$wgq_here/wgq-tree" "$@"
		;;
	route)
		shift
		WGQ_PROG="$PROG route" export WGQ_PROG
		exec "$wgq_here/wgq-route" "$@"
		;;
	restart)
		shift
		# restart's subject is "everything stale", so bare restart is
		# the full offered cycle, not a picker: the plan itself is the
		# explicit choice, confirmed before anything moves.
		if [ -z "$zone" ] && [ $# -ge 1 ] && is_owned_zone "$1"; then
			zone=$1
			shift
		fi
		[ $# -eq 0 ] || usage
		WGQ_PROG="$PROG restart" export WGQ_PROG
		exec "$wgq_here/wgq-restart" ${zone:+"$zone"}
		;;
	connect | disconnect | up | down)
		case "$verb" in up) verb=connect ;; down) verb=disconnect ;; esac
		shift
		if [ -z "$zone" ] && [ $# -ge 1 ] && is_owned_zone "$1"; then
			zone=$1
			shift
		fi
		[ $# -eq 0 ] || usage
		WGQ_PROG="$PROG" export WGQ_PROG
		if [ -n "$zone" ]; then
			exec "$wgq_here/wgq-ctl" --zone "$zone" "$verb"
		fi
		# picked, possibly several: per-zone verbs multi-select
		c_rc=0
		for c_z in $(pick_zone 1); do
			"$wgq_here/wgq-ctl" --zone "$c_z" "$verb" || c_rc=1
		done
		exit "$c_rc"
		;;
	set | get)
		shift
		v_global=0
		[ "$verb" = set ] && [ "${1:-}" = --global ] && v_global=1
		if [ "$v_global" -eq 0 ] && [ -z "$zone" ] && [ $# -ge 1 ]; then
			case "$1" in
				autoconnect | dns | default) ;; # a key, not a zone
				*)
					if is_owned_zone "$1"; then
						zone=$1
						shift
					fi
					;;
			esac
		fi
		if [ -z "$zone" ]; then
			if [ "$v_global" -eq 1 ]; then
				zone=- # global writes have no subject qube
			else
				zone=$(pick_zone 0)
			fi
		fi
		WGQ_PROG="$PROG" export WGQ_PROG
		exec "$wgq_here/wgq-ctl" --zone "$zone" "$verb" "$@"
		;;
	uninstall)
		exec "$wgq_here/wgq-uninstall"
		;;
	credential)
		# The secret is typed in dom0 and piped straight into the file
		# inside wgq-mgmt: it never touches a disk outside that qube.
		[ $# -eq 2 ] || usage
		provider=$2
		case "$provider" in
			'' | *[!a-z0-9-]*) die "unusable provider name '$provider'" ;;
		esac
		printf '%s account id (input hidden): ' "$provider"
		stty -echo 2>/dev/null || true
		acct=""
		read -r acct || true
		stty echo 2>/dev/null || true
		printf '\n'
		[ -n "$acct" ] || die "empty account id; nothing written"
		# Written as root: /rw/config is root-owned inside every qube,
		# and dom0's qrexec runs as root by dom0's own authority -- no
		# in-qube sudo involved, so this works even on a mgmt qube with
		# passwordless root removed. Then handed to user, who is what
		# the management verbs run as and what the CLI's mode-600 check
		# expects to own the file.
		trace "-> qvm-run -u root $MGMT 'umask 077 && cat > /rw/config/$provider-account && chown user:user ...'"
		printf '%s\n' "$acct" | qvm-run --no-gui --pass-io -u root -- "$MGMT" \
			"umask 077 && cat > /rw/config/$provider-account && chown user:user /rw/config/$provider-account"
		ok "credential stored in $MGMT:/rw/config/$provider-account (mode 600, owner user)"
		exit 0
		;;
	sync)
		# The qvm-copy dance, framed: stream the bundle out of wgq-mgmt
		# and into the zone's VPN qube, then apply it there. The zone
		# name is validated above, so embedding it is safe.
		shift
		if [ -z "$zone" ] && [ $# -ge 1 ] && is_owned_zone "$1"; then
			zone=$1
			shift
		fi
		[ $# -eq 0 ] || usage
		[ -n "$zone" ] || zone=$(pick_zone 0)
		check_zone "$zone"
		s_vpn=$(vpn_name "$zone")
		trace "-> qvm-run -u user $MGMT 'tar -C ~/.local/share/wgq/zones/$zone -cf - peers'"
		trace "   | qvm-run -u root $s_vpn 'tar -xf - && wgq apply peers'"
		qvm-run --no-gui --pass-io -u user -- "$MGMT" \
			"tar -C /home/user/.local/share/wgq/zones/$zone -cf - peers" \
			| qvm-run --no-gui --pass-io -u root -- "$s_vpn" \
				"rm -rf /tmp/wgq-sync && mkdir -p /tmp/wgq-sync && tar -xf - -C /tmp/wgq-sync && wgq apply /tmp/wgq-sync/peers && rm -rf /tmp/wgq-sync"
		exit 0
		;;
	keygen | apply | switch | pubkey | status)
		shift
		# keygen/pubkey/status take no own arguments, so a first arg is
		# a zone or a mistake; apply and switch keep their last argument
		# (path, peer) even when it collides with a zone's name.
		case "$verb" in
			apply | switch) v_min=1 ;;
			*) v_min=0 ;;
		esac
		if [ -z "$zone" ] && [ $# -gt "$v_min" ]; then
			if is_owned_zone "$1"; then
				zone=$1
				shift
			elif [ "$v_min" -eq 0 ]; then
				die "'$1' is not a zone ($verb takes none of its own arguments)"
			fi
		fi
		[ -n "$zone" ] || zone=$(pick_zone 0)
		check_zone "$zone"
		case "$verb" in
			keygen | apply | switch) run_in "$(vpn_name "$zone")" root "$verb" "$@" ;;
			*) run_in "$(vpn_name "$zone")" user "$verb" "$@" ;;
		esac
		;;
	*)
		run_in "$MGMT" user "$@"
		;;
esac
